local currentServerRegion = {name = "DETECTING", code = "??", basePing = 0, flag = "🌐"}

local function detectServerRegion()
    local jobId = game.JobId
    if jobId and jobId ~= "" then
        for _, region in ipairs(serverRegions) do
            if string.find(string.upper(jobId), region.code) then
                currentServerRegion = region
                return region
            end
        end
    end
    local dataCenterStat = Stats:FindFirstChild("DataCenter")
    if dataCenterStat and dataCenterStat:FindFirstChild("Location") then
        local location = dataCenterStat.Location.Value
        for _, region in ipairs(serverRegions) do
            if string.find(string.upper(location), region.code) then
                currentServerRegion = region
                return region
            end
        end
    end
    currentServerRegion = serverRegions[5]
    return currentServerRegion
end

