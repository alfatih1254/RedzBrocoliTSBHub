local function updateTargetList()
    if not targetListFrame then return end
    for _, btn in pairs(targetButtons) do pcall(function() btn:Destroy() end) end
    targetButtons = {}
    local y = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local btn = Instance.new("TextButton", targetListFrame)
            btn.Size = UDim2.new(1, -10, 0, 42)
            btn.Position = UDim2.new(0, 5, 0, y)
            btn.Text = "  👤  " .. p.DisplayName
            btn.TextColor3 = Color3.fromRGB(220, 220, 255)
            btn.TextSize = 13
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Font = Enum.Font.Gotham
            btn.BackgroundColor3 = Color3.fromRGB(35, 25, 70)
            btn.BackgroundTransparency = 0.3
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
            
            btn.MouseButton1Click:Connect(function()
                selectedTarget = p
                for _, b in pairs(targetButtons) do
                    b.BackgroundColor3 = Color3.fromRGB(35, 25, 70)
                    b.BackgroundTransparency = 0.3
                end
                btn.BackgroundColor3 = Color3.fromRGB(100, 50, 200)
                btn.BackgroundTransparency = 0.1
                if statusLabel then statusLabel.Text = "🎯 TARGET: " .. p.DisplayName end
            end)
            table.insert(targetButtons, btn)
            y = y + 50
        end
    end
    targetListFrame.CanvasSize = UDim2.new(0, 0, 0, y + 10)
end

