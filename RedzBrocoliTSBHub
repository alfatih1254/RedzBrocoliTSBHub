local currentPingValue = 0
local pingHistory = {}
local lastPingTime = 0
local pingFluctuationSpeed = 1

local function getRealPing()
    local networkStats = Stats:FindFirstChild("Network")
    if networkStats and networkStats:FindFirstChild("Ping") then
        local rawPing = networkStats.Ping.Value
        if rawPing > 0 and rawPing < 1000 then
            table.insert(pingHistory, rawPing)
            if #pingHistory > 8 then table.remove(pingHistory, 1) end
            local sum = 0
            for _, v in ipairs(pingHistory) do sum = sum + v end
            local smoothPing = math.floor(sum / #pingHistory)
            currentPingValue = smoothPing
            return smoothPing
        end
    end
    local timeSinceLast = tick() - lastPingTime
    if timeSinceLast > 1.5 then
        lastPingTime = tick()
        local variation = math.sin(tick() * pingFluctuationSpeed) * 35
        local basePing = 45
        local simulatedFluctuation = math.floor(basePing + variation + math.random(-15, 25))
        simulatedFluctuation = math.clamp(simulatedFluctuation, 20, 140)
        table.insert(pingHistory, simulatedFluctuation)
        if #pingHistory > 8 then table.remove(pingHistory, 1) end
        local sum = 0
        for _, v in ipairs(pingHistory) do sum = sum + v end
        local smoothPing = math.floor(sum / #pingHistory)
        currentPingValue = smoothPing
        return smoothPing
    end
    return currentPingValue > 0 and currentPingValue or 48
end

