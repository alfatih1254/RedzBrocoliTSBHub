local function storeOriginalCollision()
    local character = LocalPlayer.Character
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and originalCollisionStates[part] == nil then
            originalCollisionStates[part] = part.CanCollide
        end
    end
end

local function activateNoclip()
    local character = LocalPlayer.Character
    if not character then return end
    storeOriginalCollision()
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function deactivateNoclip()
    local character = LocalPlayer.Character
    if not character then return end
    for part, originalState in pairs(originalCollisionStates) do
        if part and part.Parent then
            part.CanCollide = originalState
        end
    end
    originalCollisionStates = {}
end

local function runNoclipLoop()
    if noclipLoopRunning then return end
    noclipLoopRunning = true
    task.spawn(function()
        while noClip do
            activateNoclip()
