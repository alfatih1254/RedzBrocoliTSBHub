local safePositions = {
    Vector3.new(0, 500, 0), Vector3.new(100, 450, 100), Vector3.new(-100, 480, -100),
    Vector3.new(200, 520, -150), Vector3.new(-200, 550, 150), Vector3.new(150, 490, -200),
    Vector3.new(-150, 510, 200), Vector3.new(300, 530, 50), Vector3.new(-300, 560, -50),
    Vector3.new(50, 600, 50), Vector3.new(-50, 580, -50), Vector3.new(250, 500, -250),
    Vector3.new(-250, 520, 250), Vector3.new(350, 480, 50), Vector3.new(-350, 510, -50),
    Vector3.new(180, 550, -180), Vector3.new(-180, 540, 180), Vector3.new(120, 600, -120),
    Vector3.new(-120, 590, 120), Vector3.new(0, 650, 0), Vector3.new(400, 550, 400),
    Vector3.new(-400, 560, -400), Vector3.new(500, 500, -300), Vector3.new(-500, 520, 300),
    Vector3.new(250, 650, -250), Vector3.new(-250, 640, 250)
}

local function findSafestPosition()
    local players = Players:GetPlayers()
    local bestPosition = safePositions[1]
    local bestDistance = 0
    
    for _, pos in ipairs(safePositions) do
        local minDistanceToPlayer = math.huge
        for _, player in ipairs(players) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (pos - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < minDistanceToPlayer then
                    minDistanceToPlayer = distance
                end
            end
        end
        if minDistanceToPlayer > bestDistance then
            bestDistance = minDistanceToPlayer
            bestPosition = pos
        end
    end
    return bestPosition
end

local function teleportToSafePlace()
    local character = LocalPlayer.Character
    if not character then return false end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end
    
    local safePos = findSafestPosition()
    humanoidRootPart.CFrame = CFrame.new(safePos)
    
    -- Visual effect for teleport
    local teleportEffect = Instance.new("Part")
    teleportEffect.Size = Vector3.new(6, 1, 6)
    teleportEffect.Position = safePos - Vector3.new(0, 3, 0)
    teleportEffect.Anchored = true
    teleportEffect.CanCollide = false
    teleportEffect.Transparency = 0.3
    teleportEffect.BrickColor = BrickColor.new("Bright violet")
    teleportEffect.Material = Enum.Material.Neon
    teleportEffect.Parent = Workspace
    Instance.new("UICorner", teleportEffect).CornerRadius = UDim.new(1, 0)
    
    TweenService:Create(teleportEffect, TweenInfo.new(0.5), {Transparency = 1, Size = Vector3.new(8, 1, 8)}):Play()
    task.delay(0.5, function() pcall(function() teleportEffect:Destroy() end) end)
    return true
end

