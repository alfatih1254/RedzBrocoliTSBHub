local function updateTargetList()
    for _, child in ipairs(targetScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local enemies = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(enemies, p) end
    end
    
    playerCountLabel.Text = "👥 " .. #Players:GetPlayers() .. " Players | ⚔️ " .. #enemies .. " Enemies"
    
    if #enemies == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -20, 0, 40)
        empty.Text = "✨ No other players in server ✨"
        empty.TextColor3 = Color3.fromRGB(180, 180, 220)
        empty.TextSize = 12
        empty.BackgroundTransparency = 1
        empty.Parent = targetScroll
        return
    end
    
    for _, enemy in ipairs(enemies) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -20, 0, 50)
        btn.Text = "  👤  " .. enemy.Name .. "  ▶  CLICK TO TARGET"
        btn.TextColor3 = Color3.fromRGB(220, 220, 255)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.TextSize = 12
        btn.Font = Enum.Font.Gotham
        btn.BackgroundColor3 = Color3.fromRGB(40, 15, 80)
        btn.BackgroundTransparency = 0.45
        btn.BorderSizePixel = 0
        btn.Parent = targetScroll
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 10)
        btnCorner.Parent = btn
        
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundTransparency = 0.2}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundTransparency = 0.45}):Play()
        end)
        
        btn.MouseButton1Click:Connect(function()
            if currentHighlight then pcall(function() currentHighlight:Destroy() end) end
            if highlightConn then pcall(function() highlightConn:Disconnect() end) end
            
            selectedTarget = enemy
            
            local hl = Instance.new("Highlight")
            hl.Name = "Redz_HL"
            hl.FillColor = Color3.fromRGB(200, 0, 255)
            hl.FillTransparency = 0.35
            hl.OutlineColor = Color3.fromRGB(255, 100, 255)
            hl.OutlineTransparency = 0.15
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = enemy.Character
            hl.Parent = enemy.Character
            currentHighlight = hl
            
            highlightConn = enemy.CharacterAdded:Connect(function(newChar)
                task.wait(0.15)
                if selectedTarget == enemy then
                    pcall(function() if currentHighlight then currentHighlight:Destroy() end end)
                    local newHl = Instance.new("Highlight")
                    newHl.Name = "Redz_HL"
                    newHl.FillColor = Color3.fromRGB(200, 0, 255)
                    newHl.FillTransparency = 0.35
                    newHl.OutlineColor = Color3.fromRGB(255, 100, 255)
                    newHl.OutlineTransparency = 0.15
                    newHl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    newHl.Adornee = newChar
                    newHl.Parent = newChar
                    currentHighlight = newHl
                end
            end)
            
            for _, b in ipairs(targetScroll:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = Color3.fromRGB(40, 15, 80)
                    b.BackgroundTransparency = 0.45
                    b.TextColor3 = Color3.fromRGB(220, 220, 255)
                end
            end
            
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
            btn.BackgroundTransparency = 0.15
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            
            statusText.Text = "🎯 " .. currentMode .. " | TARGET: " .. enemy.Name
            
            local char = enemy.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local orig = part.Color
                        part.Color = Color3.fromRGB(255, 100, 200)
                        task.delay(0.2, function() pcall(function() part.Color = orig end) end)
                    end
                end
            end
        end)
    end
