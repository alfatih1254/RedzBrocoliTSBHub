local function getPrecisionHealthColor(healthPercent)
    if healthPercent >= 98 then return Color3.fromRGB(0, 255, 0)
    elseif healthPercent >= 95 then return Color3.fromRGB(51, 255, 0)
    elseif healthPercent >= 92 then return Color3.fromRGB(102, 255, 0)
    elseif healthPercent >= 88 then return Color3.fromRGB(153, 255, 0)
    elseif healthPercent >= 85 then return Color3.fromRGB(204, 255, 0)
    elseif healthPercent >= 82 then return Color3.fromRGB(255, 255, 0)
    elseif healthPercent >= 78 then return Color3.fromRGB(255, 242, 0)
    elseif healthPercent >= 75 then return Color3.fromRGB(255, 229, 0)
    elseif healthPercent >= 72 then return Color3.fromRGB(255, 216, 0)
    elseif healthPercent >= 68 then return Color3.fromRGB(255, 204, 0)
    elseif healthPercent >= 65 then return Color3.fromRGB(255, 191, 0)
    elseif healthPercent >= 62 then return Color3.fromRGB(255, 178, 0)
    elseif healthPercent >= 58 then return Color3.fromRGB(255, 165, 0)
    elseif healthPercent >= 55 then return Color3.fromRGB(255, 153, 0)
    elseif healthPercent >= 52 then return Color3.fromRGB(255, 140, 0)
    elseif healthPercent >= 48 then return Color3.fromRGB(255, 127, 0)
    elseif healthPercent >= 45 then return Color3.fromRGB(255, 114, 0)
    elseif healthPercent >= 42 then return Color3.fromRGB(255, 102, 0)
    elseif healthPercent >= 38 then return Color3.fromRGB(255, 89, 0)
    elseif healthPercent >= 35 then return Color3.fromRGB(255, 76, 0)
    elseif healthPercent >= 32 then return Color3.fromRGB(255, 63, 0)
    elseif healthPercent >= 28 then return Color3.fromRGB(255, 51, 0)
    elseif healthPercent >= 25 then return Color3.fromRGB(255, 38, 0)
    elseif healthPercent >= 22 then return Color3.fromRGB(255, 25, 0)
    elseif healthPercent >= 18 then return Color3.fromRGB(255, 13, 0)
    elseif healthPercent >= 15 then return Color3.fromRGB(255, 0, 0)
    elseif healthPercent >= 12 then return Color3.fromRGB(204, 0, 0)
    elseif healthPercent >= 9 then return Color3.fromRGB(153, 0, 0)
    elseif healthPercent >= 6 then return Color3.fromRGB(102, 0, 0)
    elseif healthPercent >= 3 then return Color3.fromRGB(51, 0, 0)
    else return Color3.fromRGB(20, 0, 0)
    end
end

local function blendColors(colorA, colorB, blendFactor)
    return Color3.new(
        colorA.R + (colorB.R - colorA.R) * blendFactor,
        colorA.G + (colorB.G - colorA.G) * blendFactor,
        colorA.B + (colorB.B - colorA.B) * blendFactor
    )
end

local function getSmoothHealthColor(healthPercent)
    if healthPercent >= 80 then
        local blendFactor = (healthPercent - 80) / 20
        return blendColors(Color3.fromRGB(204, 255, 0), Color3.fromRGB(0, 255, 0), blendFactor)
    elseif healthPercent >= 60 and healthPercent < 80 then
        local blendFactor = (healthPercent - 60) / 20
        return blendColors(Color3.fromRGB(255, 178, 0), Color3.fromRGB(204, 255, 0), blendFactor)
    elseif healthPercent >= 40 and healthPercent < 60 then
        local blendFactor = (healthPercent - 40) / 20
        return blendColors(Color3.fromRGB(255, 76, 0), Color3.fromRGB(255, 178, 0), blendFactor)
    elseif healthPercent >= 20 and healthPercent < 40 then
        local blendFactor = (healthPercent - 20) / 20
        return blendColors(Color3.fromRGB(153, 0, 0), Color3.fromRGB(255, 76, 0), blendFactor)
    else
        local blendFactor = healthPercent / 20
        return blendColors(Color3.fromRGB(20, 0, 0), Color3.fromRGB(153, 0, 0), blendFactor)
    end
end

local function refreshESPForPlayer(player)
    if not espDataStore[player] then return end
    if not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
    local humanoidObject = player.Character.Humanoid
    local healthRatio = (humanoidObject.Health / humanoidObject.MaxHealth) * 100
    local preciseHealthColor = getSmoothHealthColor(healthRatio)
    
    if espDataStore[player].healthFill then
        espDataStore[player].healthFill.Size = UDim2.new(humanoidObject.Health / humanoidObject.MaxHealth, 0, 1, 0)
        espDataStore[player].healthFill.BackgroundColor3 = preciseHealthColor
    end
    if espDataStore[player].healthLabel then
        espDataStore[player].healthLabel.Text = string.format("%.1f%%", healthRatio)
        espDataStore[player].healthLabel.TextColor3 = preciseHealthColor
    end
    if espDataStore[player].highlightObject then
        espDataStore[player].highlightObject.FillColor = preciseHealthColor
        espDataStore[player].highlightObject.OutlineColor = preciseHealthColor
        espDataStore[player].highlightObject.FillTransparency = 0.42
        espDataStore[player].highlightObject.OutlineTransparency = 0.12
    end
    if espDataStore[player].distanceLabel and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("HumanoidRootPart") then
        local distanceValue = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
        local distanceColorChoice = distanceValue < 25 and Color3.fromRGB(255, 60, 60) or (distanceValue < 60 and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(100, 255, 100))
        espDataStore[player].distanceLabel.Text = math.floor(distanceValue) .. "m"
        espDataStore[player].distanceLabel.TextColor3 = distanceColorChoice
    end
end

