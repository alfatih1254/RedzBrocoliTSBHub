-- Minimize
local function toggleMinimize()
    isMinimized = not isMinimized
    if isMinimized then
        main.Size, main.Position = UDim2.new(0, 200, 0, 40), UDim2.new(1, -210, 0, 50)
        header.Visible, infoBar.Visible, leftPanel.Visible, rightPanel.Visible = false, false, false, false
        minBtn.Text = "➕ MAXIMIZE"
    else
        main.Size, main.Position = UDim2.new(0, 950, 0, 650), UDim2.new(0.5, -475, 0.5, -325)
        header.Visible, infoBar.Visible, leftPanel.Visible, rightPanel.Visible = true, true, true, true
        minBtn.Text = "➖ MINIMIZE"
    end
end
minBtn.MouseButton1Click:Connect(toggleMinimize)

-- Keybinds
UserInputService.InputBegan:Connect(function(i, p)
    if p then return end
    if i.KeyCode == Enum.KeyCode.V then
        toggleGodMode()
        godBtn2.Text = godMode and "[🔘] GODMODE (Tekan V)" or "[⚪] GODMODE (Tekan V)"
        godBtn2.BackgroundColor3 = godMode and Color3.fromRGB(0,120,0) or Color3.fromRGB(60,40,100)
        saveConfig()
    elseif i.KeyCode == Enum.KeyCode.E then
        toggleESP()
        for _, btn in pairs(visualFeatureBtns) do
            if btn and btn.Text:find("PLAYER ESP") then
                btn.Text = espOn and "[🔘] PLAYER ESP" or "[⚪] PLAYER ESP"
                btn.BackgroundColor3 = espOn and Color3.fromRGB(0,120,0) or Color3.fromRGB(60,40,100)
            end
        end
        saveConfig()
    elseif i.KeyCode == Enum.KeyCode.M then
        toggleMinimize()
    end
end)

