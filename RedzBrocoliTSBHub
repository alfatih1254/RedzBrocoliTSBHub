-- CONFIGURATION SYSTEM (SAVE/LOAD)
-- ============================================
local configKey = "RedzBrocoli_Config"

-- DEFAULT CONFIGURATION
local defaultConfig = {
    autoCombo = false,
    instantKill = false,
    autoBlock = false,
    speedHack = false,
    noClip = false,
    infiniteJump = false,
    teleportTarget = false,
    espOn = true,
    chams = false,
    godMode = false,
    emergency = true,
    soloRadius = 5,
    orbitRadius = 5,
    orbitSpeed = 1,
    feetDist = 3,
    currentMode = "SOLO"
}

-- Load config dari storage
local function loadConfig()
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(configKey))
    end)
    if success and data then
        for k, v in pairs(data) do
            if defaultConfig[k] ~= nil then
                defaultConfig[k] = v
            end
        end
        return true
    end
    return false
end

-- Save config ke storage
local function saveConfig()
    local data = {
        autoCombo = autoCombo,
        instantKill = instantKill,
        autoBlock = autoBlock,
        speedHack = speedHack,
        noClip = noClip,
        infiniteJump = infiniteJump,
        teleportTarget = teleportTarget,
        espOn = espOn,
        chams = chams,
        godMode = godMode,
        emergency = emergency,
        soloRadius = soloRadius,
        orbitRadius = orbitRadius,
        orbitSpeed = orbitSpeed,
        feetDist = feetDist,
        currentMode = currentMode
    }
    local success, err = pcall(function()
        writefile(configKey, HttpService:JSONEncode(data))
    end)
    return success
end

-- Apply config ke variabel
local function applyConfig(config)
    autoCombo = config.autoCombo
    instantKill = config.instantKill
    autoBlock = config.autoBlock
    speedHack = config.speedHack
    noClip = config.noClip
    infiniteJump = config.infiniteJump
    teleportTarget = config.teleportTarget
    espOn = config.espOn
    chams = config.chams
    godMode = config.godMode
    emergency = config.emergency
    soloRadius = config.soloRadius
    orbitRadius = config.orbitRadius
    orbitSpeed = config.orbitSpeed
    feetDist = config.feetDist
    currentMode = config.currentMode
    
    -- Terapkan efek
    if espOn then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then createESP(p) end end
    end
    if godMode then toggleGodMode() end
    if speedHack then runSpeedHack() end
    if noClip then runNoClip() end
    if chams then runChams() end
    if teleportTarget then runTeleportTarget() end
end

-- Reset ke default
local function resetToDefault()
