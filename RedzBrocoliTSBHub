local function getRealPing()
    local networkStats = Stats:FindFirstChild("Network")
    if networkStats and networkStats:FindFirstChild("Ping") then
        return math.floor(networkStats.Ping.Value)
    end
    return math.random(20, 150)
end

local function getServerId()
    local jobId = game.JobId
    if jobId and jobId ~= "" then
        local shortId = string.sub(jobId, 1, 8)
        return shortId:upper()
    end
    return "SERVER_" .. tostring(math.random(1000, 9999))
end

