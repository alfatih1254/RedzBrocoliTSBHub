-- ============================================
-- GODMODE
-- ============================================
local function toggleGodMode()
    godMode = not godMode
    if godMode then
        if currentFF then currentFF:Destroy() end
        currentFF = Instance.new("ForceField", LocalPlayer.Character)
        currentFF.Name = "GodMode"
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if h then h.BreakJointsOnDeath = false end
    else
        if currentFF then currentFF:Destroy() end
        local c = LocalPlayer.Character
        if c then
            for _, v in ipairs(c:GetChildren()) do if v:IsA("ForceField") then v:Destroy() end end
            local h = c:FindFirstChild("Humanoid")
            if h then h.BreakJointsOnDeath = true end
        end
    end
end

-- ============================================
-- ESP SYSTEM
-- ============================================
local function getHealthColor(p)
    if p >= 75 then return Color3.fromRGB(0,255,0)
    elseif p >= 50 then return Color3.fromRGB(255,255,0)
    elseif p >= 25 then return Color3.fromRGB(255,165,0)
    else return Color3.fromRGB(255,0,0) end
end

local function createESP(plr)
    if plr == LocalPlayer or espList[plr] then return end
    if not plr.Character then return end
    local hum = plr.Character:FindFirstChild("Humanoid")
    if not hum then return end
    local hp = (hum.Health/hum.MaxHealth)*100
    local hl = Instance.new("Highlight")
    hl.FillColor, hl.FillTransparency, hl.OutlineColor = getHealthColor(hp), 0.55, getHealthColor(hp)
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = plr.Character
    hl.Parent = plr.Character
    local bb = Instance.new("BillboardGui")
    bb.Size, bb.StudsOffset, bb.AlwaysOnTop = UDim2.new(0,140,0,55), Vector3.new(0,2.8,0), true
    bb.Parent = plr.Character
    local bg = Instance.new("Frame", bb)
    bg.Size, bg.BackgroundColor3, bg.BackgroundTransparency = UDim2.new(1,0,1,0), Color3.fromRGB(0,0,0), 0.55
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0,8)
    local name = Instance.new("TextLabel", bg)
    name.Size, name.Position, name.Text, name.TextColor3, name.Font, name.TextSize = UDim2.new(1,0,0,22), UDim2.new(0,0,0,2), plr.DisplayName, Color3.fromRGB(255,255,255), Enum.Font.GothamBold, 12
    name.BackgroundTransparency = 1
    local user = Instance.new("TextLabel", bg)
    user.Size, user.Position, user.Text, user.TextColor3, user.TextSize = UDim2.new(1,0,0,14), UDim2.new(0,0,0,24), "(@"..plr.Name..")", Color3.fromRGB(180,180,180), 9
    user.BackgroundTransparency = 1
    local hbBg = Instance.new("Frame", bg)
    hbBg.Size, hbBg.Position, hbBg.BackgroundColor3 = UDim2.new(0.9,0,0,6), UDim2.new(0.05,0,0,40), Color3.fromRGB(50,50,50)
    Instance.new("UICorner", hbBg).CornerRadius = UDim.new(0,3)
    local hbFill = Instance.new("Frame", hbBg)
    hbFill.Size, hbFill.BackgroundColor3 = UDim2.new(hp/100,0,1,0), getHealthColor(hp)
    Instance.new("UICorner", hbFill).CornerRadius = UDim.new(0,3)
    local hpText = Instance.new("TextLabel", bg)
    hpText.Size, hpText.Position, hpText.Text, hpText.TextColor3, hpText.TextSize = UDim2.new(1,0,0,12), UDim2.new(0,0,0,48), math.floor(hp).."%", Color3.fromRGB(255,255,255), 9
    hpText.BackgroundTransparency = 1
    espList[plr] = {hl=hl, bb=bb, fill=hbFill, txt=hpText}
    local conn = RunService.Heartbeat:Connect(function()
        if not plr.Character or not plr.Character:FindFirstChild("Humanoid") then return end
        local h = plr.Character.Humanoid
        local nhp = (h.Health/h.MaxHealth)*100
        if espList[plr] then
            espList[plr].fill.Size = UDim2.new(h.Health/h.MaxHealth,0,1,0)
            espList[plr].fill.BackgroundColor3 = getHealthColor(nhp)
            espList[plr].txt.Text = math.floor(nhp).."%"
            espList[plr].hl.FillColor = getHealthColor(nhp)
        end
    end)
    table.insert(activeConns, conn)
end

local function removeESP()
    for _, d in pairs(espList) do
        if d.hl then d.hl:Destroy() end
        if d.bb then d.bb:Destroy() end
    end
    espList = {}
end

local function toggleESP()
    espOn = not espOn
    if espOn then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then createESP(p) end end
    else
        removeESP()
    end
end

