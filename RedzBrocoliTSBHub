UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        activate()
    elseif input.KeyCode == Enum.KeyCode.Delete then
        stopAllActions()
    elseif input.KeyCode == Enum.KeyCode.V then
        toggleGodMode()
        godBtn.Text = godMode and "✅ GODMODE (V) - ACTIVE" or "⬜ GODMODE (V) - INACTIVE"
        godBtn.BackgroundColor3 = godMode and Color3.fromRGB(100, 100, 255) or Color3.fromRGB(45, 35, 85)
    elseif input.KeyCode == Enum.KeyCode.E then
        currentEsp = not currentEsp
        toggleESP()
        for _, btn in pairs(visualFeatureButtonList) do
            if btn and btn.Text and btn.Text:find("ESP") then
                btn.Text = currentEsp and "✅ PLAYER ESP" or "⬜ PLAYER ESP"
                btn.BackgroundColor3 = currentEsp and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(45, 35, 85)
            end
        end
    elseif input.KeyCode == Enum.KeyCode.M then
        toggleMinimize()
    elseif input.KeyCode == Enum.KeyCode.T then
        local highest = findHighestGroundPosition()
        if highest then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = highest
                showNotification("Teleported to highest ground!", 2)
            end
        end
    end
end)

