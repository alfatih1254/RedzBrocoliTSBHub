-- ============================================
-- EMERGENCY TELEPORT
-- ============================================
local function emergencyTeleportCheck()
    if not emergencyEnabled or emergencyTeleported then return false end
    
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return false end
    
    local hpPercent = (hum.Health / hum.MaxHealth) * 100
    if hpPercent < 25 then
        emergencyTeleported = true
        
        if isActive then
            for _, c in pairs(activeConnections) do pcall(function() c:Disconnect() end) end
            activeConnections = {}
            isActive = false
        end
        
        teleportToSafePlace()
        statusText.Text = "🚨 EMERGENCY: TELEPORTED!"
        led.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
        
        for i = 1, 3 do
            led.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            task.wait(0.1)
            led.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
            task.wait(0.1)
        end
        
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "🚨 EMERGENCY ESCAPE",
                Text = "HP below 25%! Teleported to safe location!",
                Duration = 3
            })
        end)
        
        task.delay(10, function()
            emergencyTeleported = false
            if not isActive then
                led.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                statusText.Text = "MODE: INACTIVE | TARGET: " .. (selectedTarget and selectedTarget.Name or "NONE")
            end
        end)
        return true
    end
    return false
end

-- ============================================
-- CLEANUP & ACTIVATE
-- ============================================
local function cleanup()
    for _, c in pairs(activeConnections) do pcall(function() c:Disconnect() end) end
    activeConnections = {}
    isActive = false
    emergencyTeleported = false
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = 16
        char.Humanoid.JumpPower = 50
    end
    
    if selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("Humanoid") then
        selectedTarget.Character.Humanoid.WalkSpeed = 16
        selectedTarget.Character.Humanoid.JumpPower = 50
    end
    
    if not godModeEnabled then
        led.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        statusText.Text = "MODE: INACTIVE | TARGET: " .. (selectedTarget and selectedTarget.Name or "NONE")
    end
end

local function activateMode()
    if not selectedTarget then
        statusText.Text = "⚠️ SELECT TARGET FIRST!"
        return
    end
    
    cleanup()
    task.wait(0.1)
    isActive = true
    orbitAngle = 0
    emergencyTeleported = false
    
    led.BackgroundColor3 = Color3.fromRGB(0, 200, 150)
    statusText.Text = "⚡ " .. currentMode .. " | TARGET: " .. selectedTarget.Name
    
    local char = LocalPlayer.Character
    if not char then
        LocalPlayer.CharacterAdded:Wait()
        char = LocalPlayer.Character
    end
    
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = 180
        char.Humanoid.JumpPower = 120
    end
    
    if selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("Humanoid") then
        selectedTarget.Character.Humanoid.WalkSpeed = 0
        selectedTarget.Character.Humanoid.JumpPower = 0
        
        local targetConn = selectedTarget.CharacterAdded:Connect(function(newChar)
            task.wait(0.2)
            if isActive and selectedTarget and newChar and newChar:FindFirstChild("Humanoid") then
                newChar.Humanoid.WalkSpeed = 0
                newChar.Humanoid.JumpPower = 0
            end
        end)
        table.insert(activeConnections, targetConn)
    end
    
    local emergConn = RunService.Stepped:Connect(emergencyTeleportCheck)
    table.insert(activeConnections, emergConn)
    
    if currentMode == "SOLO" then
        local teleConn = RunService.RenderStepped:Connect(function()
            if not isActive or emergencyTeleported then return end
            local myChar = LocalPlayer.Character
            if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
            if not selectedTarget or not selectedTarget.Character or not selectedTarget.Character:FindFirstChild("HumanoidRootPart") then return end
            
            local tPos = selectedTarget.Character.HumanoidRootPart.Position
            local ang = math.random() * 2 * math.pi
            local rad = soloRadius
            local x = tPos.X + math.cos(ang) * rad
            local z = tPos.Z + math.sin(ang) * rad
            local yOff = math.random(1, 4)
            
            myChar.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(x, tPos.Y + yOff, z), tPos)
            pcall(function() game:GetService("VirtualUser"):ClickButton1(Vector2.new(500, 500), 1) end)
        end)
        table.insert(activeConnections, teleConn)
        
    elseif currentMode == "ORBIT" then
        local orbitConn = RunService.RenderStepped:Connect(function()
            if not isActive or emergencyTeleported then return end
            local myChar = LocalPlayer.Character
            if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
            if not selectedTarget or not selectedTarget.Character or not selectedTarget.Character:FindFirstChild("HumanoidRootPart") then return end
            
            orbitAngle = orbitAngle + orbitSpeed * 0.05
            local tPos = selectedTarget.Character.HumanoidRootPart.Position
            local x = tPos.X + math.cos(orbitAngle) * orbitRadius
            local z = tPos.Z + math.sin(orbitAngle) * orbitRadius
            
            myChar.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(x, tPos.Y + 2, z), tPos)
            pcall(function() game:GetService("VirtualUser"):ClickButton1(Vector2.new(500, 500), 1) end)
        end)
        table.insert(activeConnections, orbitConn)
        
    elseif currentMode == "FEET" then
        local feetConn = RunService.RenderStepped:Connect(function()
            if not isActive or emergencyTeleported then return end
            local myChar = LocalPlayer.Character
            if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
            if not selectedTarget or not selectedTarget.Character or not selectedTarget.Character:FindFirstChild("HumanoidRootPart") then return end
            
            local tPos = selectedTarget.Character.HumanoidRootPart.Position
            myChar.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(tPos.X, tPos.Y - feetDistance, tPos.Z), tPos)
            pcall(function() game:GetService("VirtualUser"):ClickButton1(Vector2.new(500, 500), 1) end)
        end)
        table.insert(activeConnections, feetConn)
    end
    
    local freezeConn = RunService.Stepped:Connect(function()
        if isActive and not emergencyTeleported and selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChild("Humanoid") then
            local hum = selectedTarget.Character.Humanoid
            if hum.WalkSpeed ~= 0 then hum.WalkSpeed = 0 end
            if hum.JumpPower ~= 0 then hum.JumpPower = 0 end
        end
    end)
    table.insert(activeConnections, freezeConn)
    
    local speedConn = RunService.Heartbeat:Connect(function()
        if isActive and not emergencyTeleported and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local hum = LocalPlayer.Character.Humanoid
            if hum.WalkSpeed ~= 180 then hum.WalkSpeed = 180 end
            if hum.JumpPower ~= 120 then hum.JumpPower = 120 end
        end
    end)
    table.insert(activeConnections, speedConn)
    
    local blinkConn = RunService.Heartbeat:Connect(function()
        if isActive and not emergencyTeleported then
            local b = (math.sin(tick() * 15) + 1) / 2
            led.BackgroundColor3 = Color3.fromRGB(80 + b * 100, 40 + b * 60, 180 + b * 75)
        end
    end)
    table.insert(activeConnections, blinkConn)
end

