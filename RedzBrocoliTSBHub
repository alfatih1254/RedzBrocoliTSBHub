    end
    updateTargetList()
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        if selectedTarget then activateMode() else statusText.Text = "⚠️ SELECT TARGET FIRST!" end
    elseif input.KeyCode == Enum.KeyCode.Delete then
        cleanup()
    elseif input.KeyCode == Enum.KeyCode.V then
        toggleGodMode()
    end
end)

LocalPlayer.CharacterAdded:Connect(function(newChar)
    task.wait(0.3)
    if isActive and not emergencyTeleported and newChar and newChar:FindFirstChild("Humanoid") then
        newChar.Humanoid.WalkSpeed = 180
        newChar.Humanoid.JumpPower = 120
    end
