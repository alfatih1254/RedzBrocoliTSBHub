        currentFF = Instance.new("ForceField", LocalPlayer.Character)
        currentFF.Name = "RedzGodMode"
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then humanoid.BreakJointsOnDeath = false end
    else
        if currentFF then currentFF:Destroy() end
        local char = LocalPlayer.Character
        if char then
            for _, v in ipairs(char:GetChildren()) do if v:IsA("ForceField") then v:Destroy() end end
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then humanoid.BreakJointsOnDeath = true end
        end
    end
end

local function getHealthColor(healthPercent)
    if healthPercent >= 75 then return Color3.fromRGB(0, 255, 0)
    elseif healthPercent >= 50 then return Color3.fromRGB(255, 255, 0)
    elseif healthPercent >= 25 then return Color3.fromRGB(255, 165, 0)
    else return Color3.fromRGB(255, 0, 0) end
end

local function createESP(player)
