-- Slider setup function
local function setupSlider(sliderBg, sliderFill, label, minV, maxV, varName, currentVal)
    local dragging = false
    sliderBg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local pos = math.clamp((i.Position.X - sliderBg.AbsolutePosition.X)/sliderBg.AbsoluteSize.X, 0, 1)
            local val = minV + pos * (maxV - minV)
            sliderFill.Size = UDim2.new(pos, 0, 1, 0)
            label.Text = varName..": "..string.format("%.1f", val)
            if varName == "📍 TELEPORT RADIUS" then soloRadius = val
            elseif varName == "🔄 ORBIT RADIUS" then orbitRadius = val
            elseif varName == "⚡ ORBIT SPEED" then orbitSpeed = val
            elseif varName == "🦶 FEET DISTANCE" then feetDist = val end
        end
    end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = math.clamp((i.Position.X - sliderBg.AbsolutePosition.X)/sliderBg.AbsoluteSize.X, 0, 1)
            local val = minV + pos * (maxV - minV)
            sliderFill.Size = UDim2.new(pos, 0, 1, 0)
            label.Text = varName..": "..string.format("%.1f", val)
            if varName == "📍 TELEPORT RADIUS" then soloRadius = val
            elseif varName == "🔄 ORBIT RADIUS" then orbitRadius = val
            elseif varName == "⚡ ORBIT SPEED" then orbitSpeed = val
            elseif varName == "🦶 FEET DISTANCE" then feetDist = val end
        end
    end)
    local initPos = (currentVal - minV) / (maxV - minV)
    sliderFill.Size = UDim2.new(initPos, 0, 1, 0)
end

setupSlider(radiusSliderBg, radiusSliderFill, radiusLabel, 2, 12, "📍 TELEPORT RADIUS", soloRadius)
