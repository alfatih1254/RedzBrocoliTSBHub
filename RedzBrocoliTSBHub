-- ============================================
-- SAFE POSITIONS (TEMPAT AMAN)
-- ============================================
local safePositions = {
    Vector3.new(0, 500, 0), Vector3.new(100, 450, 100), Vector3.new(-100, 480, -100),
    Vector3.new(200, 520, -150), Vector3.new(-200, 550, 150), Vector3.new(150, 490, -200),
    Vector3.new(-150, 510, 200), Vector3.new(300, 530, 50), Vector3.new(-300, 560, -50),
    Vector3.new(50, 600, 50), Vector3.new(-50, 580, -50),
}

local function findSafePosition()
    local players = Players:GetPlayers()
    local bestPos = safePositions[1]
    local bestDistance = 0
    
    for _, pos in ipairs(safePositions) do
        local minDistToPlayer = math.huge
        for _, player in ipairs(players) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (pos - player.Character.HumanoidRootPart.Position).Magnitude
                if dist < minDistToPlayer then minDistToPlayer = dist end
            end
        end
        if minDistToPlayer > bestDistance then
            bestDistance = minDistToPlayer
            bestPos = pos
        end
    end
    return bestPos
end

local function teleportToSafePlace()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    char.HumanoidRootPart.CFrame = CFrame.new(findSafePosition())
    return true
end

-- ============================================
-- GODMODE (FORCEFIELD)
-- ============================================
local function applyGodMode()
    local char = LocalPlayer.Character
    if not char then return false end
    
    if currentForceField then pcall(function() currentForceField:Destroy() end) end
    
    currentForceField = Instance.new("ForceField")
    currentForceField.Name = "Redz_GodMode_FF"
    currentForceField.Parent = char
    
    -- Efek particle keren
    local particles = Instance.new("ParticleEmitter")
    particles.Name = "GodModeParticles"
    particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    particles.Color = ColorSequence.new(Color3.fromRGB(0, 200, 255), Color3.fromRGB(255, 50, 150))
    particles.Size = NumberSequence.new(0.5)
    particles.Rate = 40
    particles.Lifetime = NumberRange.new(0.5)
    particles.SpreadAngle = Vector2.new(360, 360)
    particles.Speed = NumberRange.new(3)
    
    local humanoidRoot = char:FindFirstChild("HumanoidRootPart")
    if humanoidRoot then particles.Parent = humanoidRoot else particles.Parent = char end
    
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.BreakJointsOnDeath = false
        local ffChecker = RunService.Heartbeat:Connect(function()
            if LocalPlayer.Character and godModeEnabled then
                local ff = LocalPlayer.Character:FindFirstChild("Redz_GodMode_FF")
                if not ff then
                    local newFF = Instance.new("ForceField")
                    newFF.Name = "Redz_GodMode_FF"
                    newFF.Parent = LocalPlayer.Character
                    currentForceField = newFF
                end
            end
        end)
        table.insert(godModeConnections, ffChecker)
    end
    return true
end

local function removeGodMode()
    if currentForceField then pcall(function() currentForceField:Destroy() end) end
    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetDescendants()) do
            if child.Name == "GodModeParticles" then child:Destroy() end
        end
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("ForceField") then child:Destroy() end
        end
        local hum = char:FindFirstChild("Humanoid")
        if hum then hum.BreakJointsOnDeath = true end
    end
    for _, conn in pairs(godModeConnections) do pcall(function() conn:Disconnect() end) end
    godModeConnections = {}
end

local function toggleGodMode()
    godModeEnabled = not godModeEnabled
    if godModeEnabled then
        applyGodMode()
        godModeBtn.Text = "🛡️ GODMODE ON"
        godModeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        godModeStatus.Text = "⚡ ACTIVE - INVINCIBLE ⚡"
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "🛡️ GODMODE ACTIVATED",
                Text = "You are now invincible! (Blue Shield Visible)",
                Duration = 2
            })
        end)
    else
        removeGodMode()
        godModeBtn.Text = "🛡️ GODMODE OFF"
        godModeBtn.BackgroundColor3 = Color3.fromRGB(100, 50, 150)
        godModeStatus.Text = "○ INACTIVE ○"
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "🛡️ GODMODE DEACTIVATED",
                Text = "You are now vulnerable again",
                Duration = 2
            })
        end)
    end
end

