    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        if selectedTarget then activate() else statusLabel.Text = "⚠️ SELECT TARGET FIRST" end
    elseif input.KeyCode == Enum.KeyCode.Delete then
        deactivate()
    elseif input.KeyCode == Enum.KeyCode.V then
        toggleGodMode()
        godModeButton.Text = godMode and "✅ GODMODE (V) - ACTIVE" or "⬜ GODMODE (V) - INACTIVE"
        godModeButton.BackgroundColor3 = godMode and Color3.fromRGB(110, 110, 255) or Color3.fromRGB(50, 40, 95)
    elseif input.KeyCode == Enum.KeyCode.E then
        currentEspState = not currentEspState
        toggleESP()
        for _, btn in pairs(visualFeatureBtns) do
            if btn and btn.Text and btn.Text:find("ESP") then
                btn.Text = currentEspState and "✅ PLAYER ESP" or "⬜ PLAYER ESP"
                btn.BackgroundColor3 = currentEspState and Color3.fromRGB(0, 190, 90) or Color3.fromRGB(50, 40, 95)
                btn.TextColor3 = currentEspState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(190, 190, 230)
            end
        end
    elseif input.KeyCode == Enum.KeyCode.M then
        toggleMinimizeUI()
    end
end)

