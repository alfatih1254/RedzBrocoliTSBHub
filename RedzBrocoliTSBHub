UserInputService.InputBegan:Connect(function(i, p)
    if p then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        if selectedTarget then activate() else statusLabel.Text = "⚠️ SELECT TARGET FIRST" end
    elseif i.KeyCode == Enum.KeyCode.Delete then
        deactivate()
    elseif i.KeyCode == Enum.KeyCode.V then
        toggleGodMode()
        for _, btn in pairs(featureBtns) do
            if btn.Text:find("GODMODE") then
                btn.Text = godMode and "✅ GODMODE" or "⬜ GODMODE"
                btn.BackgroundColor3 = godMode and Color3.fromRGB(100, 100, 255) or Color3.fromRGB(45, 35, 85)
                btn.TextColor3 = godMode and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 220)
            end
        end
    elseif i.KeyCode == Enum.KeyCode.E then
        toggleESP()
        for _, btn in pairs(featureBtns) do
            if btn.Text:find("ESP") then
                btn.Text = espOn and "✅ PLAYER ESP" or "⬜ PLAYER ESP"
                btn.BackgroundColor3 = espOn and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(45, 35, 85)
                btn.TextColor3 = espOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 220)
            end
        end
    elseif i.KeyCode == Enum.KeyCode.M then
        toggleMinimize()
    end
end)

