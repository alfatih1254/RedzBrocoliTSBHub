local function applyGodMode()
    local character = LocalPlayer.Character
    if not character then return false end
    
    if currentForceField then pcall(function() currentForceField:Destroy() end) end
    
    currentForceField = Instance.new("ForceField")
    currentForceField.Name = "Redz_GodMode_FF"
    currentForceField.Parent = character
    
    -- Particle effect
    local particleEmitter = Instance.new("ParticleEmitter")
    particleEmitter.Name = "Redz_GodMode_Particles"
    particleEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    particleEmitter.Color = ColorSequence.new(Color3.fromRGB(0, 150, 255), Color3.fromRGB(255, 50, 150))
    particleEmitter.Size = NumberSequence.new(0.5)
    particleEmitter.Rate = 45
    particleEmitter.Lifetime = NumberRange.new(0.6)
    particleEmitter.SpreadAngle = Vector2.new(360, 360)
    particleEmitter.Speed = NumberRange.new(4)
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        particleEmitter.Parent = rootPart
    else
        particleEmitter.Parent = character
    end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.BreakJointsOnDeath = false
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
    end
    
    return true
end

local function removeGodMode()
    if currentForceField then pcall(function() currentForceField:Destroy() end) end
    currentForceField = nil
    
    local character = LocalPlayer.Character
    if character then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("ForceField") then child:Destroy() end
        end
        for _, descendant in ipairs(character:GetDescendants()) do
            if descendant.Name == "Redz_GodMode_Particles" then descendant:Destroy() end
        end
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then humanoid.BreakJointsOnDeath = true end
    end
end

local function keepGodModeAlive()
    task.spawn(function()
        while screenGui and screenGui.Parent and godModeEnabled do
            local character = LocalPlayer.Character
            if character then
                local hasForceField = false
                for _, child in ipairs(character:GetChildren()) do
                    if child:IsA("ForceField") and child.Name == "Redz_GodMode_FF" then
                        hasForceField = true
                        currentForceField = child
                        break
                    end
                end
                if not hasForceField then
                    currentForceField = Instance.new("ForceField")
                    currentForceField.Name = "Redz_GodMode_FF"
                    currentForceField.Parent = character
                end
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid then humanoid.BreakJointsOnDeath = false end
            end
            task.wait(0.3)
        end
    end)
end

local function toggleGodMode()
    godModeEnabled = not godModeEnabled
    if godModeEnabled then
        applyGodMode()
        keepGodModeAlive()
        if godModeBtn then
            godModeBtn.Text = "🛡️ GODMODE ON"
            godModeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        end
        if godModeStatus then
            godModeStatus.Text = "⚡ ACTIVE - Blue Shield ⚡"
            godModeStatus.TextColor3 = Color3.fromRGB(0, 255, 200)
        end
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "🛡️ GODMODE ACTIVATED",
                Text = "You are now invincible! Blue shield protects you.",
                Duration = 2
            })
        end)
    else
        removeGodMode()
        if godModeBtn then
            godModeBtn.Text = "🛡️ GODMODE OFF"
            godModeBtn.BackgroundColor3 = Color3.fromRGB(100, 50, 150)
        end
        if godModeStatus then
            godModeStatus.Text = "○ INACTIVE ○"
            godModeStatus.TextColor3 = Color3.fromRGB(200, 150, 200)
        end
    end
end

