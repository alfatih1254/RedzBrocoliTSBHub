local function getHealthColor(percent)
    if percent >= 75 then return Color3.fromRGB(0, 255, 0)
    elseif percent >= 50 then return Color3.fromRGB(255, 255, 0)
    elseif percent >= 25 then return Color3.fromRGB(255, 165, 0)
    else return Color3.fromRGB(255, 0, 0) end
end

local function createESP(player)
    if player == LocalPlayer then return end
    if espHighlights[player] then
        if espHighlights[player].highlight then pcall(function() espHighlights[player].highlight:Destroy() end) end
        if espHighlights[player].billboard then pcall(function() espHighlights[player].billboard:Destroy() end) end
        espHighlights[player] = nil
    end
    
    if not player.Character then return end
    local character = player.Character
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    local healthPercent = (humanoid.Health / humanoid.MaxHealth) * 100
    
    -- Highlight
    local highlight = Instance.new("Highlight")
    highlight.Name = "Redz_ESP"
    highlight.FillColor = getHealthColor(healthPercent)
    highlight.FillTransparency = 0.55
    highlight.OutlineColor = getHealthColor(healthPercent)
    highlight.OutlineTransparency = 0.15
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character
    
    -- Billboard
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Redz_ESP_Billboard"
    billboard.Size = UDim2.new(0, 160, 0, 65)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = character
    
    -- Background glass
    local bg = Instance.new("Frame", billboard)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 0.55
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 8)
    
    -- Display Name
    local displayName = Instance.new("TextLabel", bg)
    displayName.Size = UDim2.new(1, 0, 0, 24)
    displayName.Position = UDim2.new(0, 0, 0, 2)
    displayName.Text = player.DisplayName
    displayName.TextColor3 = Color3.fromRGB(255, 255, 255)
    displayName.TextSize = 14
    displayName.Font = Enum.Font.GothamBold
    displayName.BackgroundTransparency = 1
    displayName.TextStrokeTransparency = 0.3
    displayName.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    
    -- Username (small)
    local userName = Instance.new("TextLabel", bg)
    userName.Size = UDim2.new(1, 0, 0, 16)
    userName.Position = UDim2.new(0, 0, 0, 26)
    userName.Text = "(@" .. player.Name .. ")"
    userName.TextColor3 = Color3.fromRGB(180, 180, 180)
    userName.TextSize = 9
    userName.Font = Enum.Font.Gotham
    userName.BackgroundTransparency = 1
    
    -- Health Bar Background
    local healthBg = Instance.new("Frame", bg)
    healthBg.Size = UDim2.new(0.9, 0, 0, 8)
    healthBg.Position = UDim2.new(0.05, 0, 0, 44)
    healthBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBg.BorderSizePixel = 0
    Instance.new("UICorner", healthBg).CornerRadius = UDim.new(0, 4)
    
    -- Health Bar Fill
    local healthFill = Instance.new("Frame", healthBg)
    healthFill.Size = UDim2.new(healthPercent / 100, 0, 1, 0)
    healthFill.BackgroundColor3 = getHealthColor(healthPercent)
    healthFill.BorderSizePixel = 0
    Instance.new("UICorner", healthFill).CornerRadius = UDim.new(0, 4)
    
    -- Health Text
    local healthText = Instance.new("TextLabel", bg)
    healthText.Size = UDim2.new(1, 0, 0, 14)
    healthText.Position = UDim2.new(0, 0, 0, 54)
    healthText.Text = math.floor(healthPercent) .. "%"
    healthText.TextColor3 = Color3.fromRGB(255, 255, 255)
    healthText.TextSize = 10
    healthText.Font = Enum.Font.Gotham
    healthText.BackgroundTransparency = 1
    
    espHighlights[player] = {
        highlight = highlight,
        billboard = billboard,
        healthFill = healthFill,
        healthText = healthText,
        healthPercent = healthPercent
    }
    
    -- Update health
    local updateConnection = RunService.Heartbeat:Connect(function()
        if not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
        local currentHumanoid = player.Character.Humanoid
        local newPercent = (currentHumanoid.Health / currentHumanoid.MaxHealth) * 100
        local fillPercent = currentHumanoid.Health / currentHumanoid.MaxHealth
        
        if espHighlights[player] then
            if espHighlights[player].healthFill then
                espHighlights[player].healthFill.Size = UDim2.new(fillPercent, 0, 1, 0)
                espHighlights[player].healthFill.BackgroundColor3 = getHealthColor(newPercent)
                espHighlights[player].healthText.Text = math.floor(newPercent) .. "%"
            end
            if espHighlights[player].highlight then
                espHighlights[player].highlight.FillColor = getHealthColor(newPercent)
                espHighlights[player].highlight.OutlineColor = getHealthColor(newPercent)
            end
        end
    end)
    table.insert(espConnections, updateConnection)
end

local function removeAllESP()
    for player, data in pairs(espHighlights) do
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
    end
    espHighlights = {}
end

