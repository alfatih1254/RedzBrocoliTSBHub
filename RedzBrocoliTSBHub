local function getHealthColor(healthPercent)
    if healthPercent >= 75 then return Color3.fromRGB(0, 255, 0)
    elseif healthPercent >= 60 then return Color3.fromRGB(255, 255, 0)
    elseif healthPercent >= 45 then return Color3.fromRGB(255, 165, 0)
    elseif healthPercent >= 30 then return Color3.fromRGB(255, 80, 0)
    elseif healthPercent >= 15 then return Color3.fromRGB(255, 0, 0)
    else return Color3.fromRGB(100, 0, 0) end
end

local function getSmoothHealthColor(healthPercent)
    if healthPercent >= 80 then
        local t = (healthPercent - 80) / 20
        return Color3.new(0 + (204/255)*t, 1, 0)
    elseif healthPercent >= 60 then
        local t = (healthPercent - 60) / 20
        return Color3.new((204/255) + (51/255)*t, 1 - t*0.5, 0)
    elseif healthPercent >= 40 then
        local t = (healthPercent - 40) / 20
        return Color3.new(1, 1 - t*0.3, 0)
    elseif healthPercent >= 20 then
        local t = (healthPercent - 20) / 20
        return Color3.new(1, 0.3 - t*0.3, 0)
    else
        local t = healthPercent / 20
        return Color3.new(1, 0, t*0.4)
    end
end

local function refreshESPForPlayer(player)
    if not espDataStore[player] then return end
    if not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
    local humanoidObj = player.Character.Humanoid
    local healthPercent = (humanoidObj.Health / humanoidObj.MaxHealth) * 100
    local preciseColor = getSmoothHealthColor(healthPercent)
    
    if espDataStore[player].healthFill then
        espDataStore[player].healthFill.Size = UDim2.new(humanoidObj.Health / humanoidObj.MaxHealth, 0, 1, 0)
        espDataStore[player].healthFill.BackgroundColor3 = preciseColor
    end
    if espDataStore[player].healthLabel then
        espDataStore[player].healthLabel.Text = math.floor(healthPercent) .. "%"
        espDataStore[player].healthLabel.TextColor3 = preciseColor
    end
    if espDataStore[player].highlight then
        espDataStore[player].highlight.FillColor = preciseColor
        espDataStore[player].highlight.OutlineColor = preciseColor
    end
    if espDataStore[player].distanceLabel and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("HumanoidRootPart") then
        local distance = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
        espDataStore[player].distanceLabel.Text = math.floor(distance) .. "m"
    end
end

local function buildESPForPlayer(player)
    if player == LocalPlayer or espDataStore[player] then return end
    if not player.Character then 
        local conn = player.CharacterAdded:Connect(function()
            task.wait(0.5)
            buildESPForPlayer(player)
            conn:Disconnect()
        end)
        return 
    end
    local humanoid = player.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    local healthPercent = (humanoid.Health / humanoid.MaxHealth) * 100
    local preciseColor = getSmoothHealthColor(healthPercent)
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = preciseColor
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = preciseColor
    highlight.OutlineTransparency = 0.2
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = player.Character
    highlight.Parent = player.Character
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 180, 0, 70)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = player.Character
    
    local bg = Instance.new("Frame", billboard)
