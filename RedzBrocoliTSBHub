        hl.OutlineTransparency = 0.15
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = selectedTarget.Character
        hl.Parent = selectedTarget.Character
        currentHighlight = hl
    end
end)

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        p.CharacterAdded:Connect(function()
            task.wait(0.25)
            if isActive and not emergencyTeleported and selectedTarget == p and p.Character and p.Character:FindFirstChild("Humanoid") then
                p.Character.Humanoid.WalkSpeed = 0
                p.Character.Humanoid.JumpPower = 0
