UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        if selectedTarget then activate() else statusLabel.Text = "⚠️ SELECT TARGET FIRST" end
    elseif input.KeyCode == Enum.KeyCode.Delete then
        deactivate()
    elseif input.KeyCode == Enum.KeyCode.V then
        toggleGodMode()
        godModeButton.Text = godMode and "✅ GODMODE (V)" or "⬜ GODMODE (V)"
        godModeButton.BackgroundColor3 = godMode and Color3.fromRGB(100, 100, 255) or Color3.fromRGB(45, 35, 85)
    elseif input.KeyCode == Enum.KeyCode.E then
        toggleESP()
        for _, btn in pairs(visualFeatureBtns) do
            if btn.Text:find("ESP") then
                btn.Text = espOn and "✅ PLAYER ESP" or "⬜ PLAYER ESP"
                btn.BackgroundColor3 = espOn and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(45, 35, 85)
            end
        end
    elseif input.KeyCode == Enum.KeyCode.M then
        toggleMinimizeUI()
    end
end)

