local function emergencyTeleportCheck()
    if not emergencyEnabled or emergencyTeleported then return false end
    
    local character = LocalPlayer.Character
    if not character then return false end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
    
    if hpPercent < 25 then
        emergencyTeleported = true
        
        if isActive then
            for _, connection in pairs(activeConnections) do
                pcall(function() connection:Disconnect() end)
            end
            activeConnections = {}
            isActive = false
        end
        
        teleportToSafePlace()
        
        if statusText then
            statusText.Text = "🚨 EMERGENCY: TELEPORTED!"
        end
        if led then
            led.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
            for i = 1, 3 do
                led.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                task.wait(0.1)
                led.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
                task.wait(0.1)
            end
        end
        
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "🚨 EMERGENCY ESCAPE",
                Text = "HP below 25%! Teleported to safe location!",
                Duration = 3
            })
        end)
        
        task.delay(10, function()
            emergencyTeleported = false
            if not isActive and statusText and led and not godModeEnabled then
                led.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                statusText.Text = "MODE: INACTIVE | TARGET: " .. (selectedTarget and selectedTarget.DisplayName or "NONE")
            end
        end)
        return true
    end
    return false
end

