local function stopChams()
    if chamsConnection then
        chamsConnection:Disconnect()
        chamsConnection = nil
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Material = Enum.Material.Plastic
                    part.Color = Color3.fromRGB(255, 255, 255)
                end
            end
        end
    end
end

local function startChams()
    if chamsConnection then return end
    chamsConnection = RunService.RenderStepped:Connect(function()
        if not chamsOn then return end
        local hue = rainbowHue
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local colorToUse = isRainbowMode and Color3.fromHSV(hue, 1, 1) or Color3.fromRGB(255, 0, 0)
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if isGlowEnabled then
                            part.Material = Enum.Material.Neon
                        else
                            part.Material = Enum.Material.ForceField
                        end
                        part.Color = colorToUse
                    end
                end
            end
        end
        if isRainbowMode then
            rainbowHue = (rainbowHue + 0.01) % 1
        end
    end)
end

