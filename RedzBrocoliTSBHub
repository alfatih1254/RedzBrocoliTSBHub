local function getHealthColor(p)
    if p >= 75 then return Color3.fromRGB(0, 255, 0)
    elseif p >= 50 then return Color3.fromRGB(255, 255, 0)
    elseif p >= 25 then return Color3.fromRGB(255, 165, 0)
    else return Color3.fromRGB(255, 0, 0) end
end

local function createESP(plr)
    if plr == LocalPlayer or espList[plr] then return end
    if not plr.Character then 
        plr.CharacterAdded:Connect(function() wait(0.5) createESP(plr) end)
        return 
    end
    local hum = plr.Character:FindFirstChild("Humanoid")
    if not hum then return end
    local hp = (hum.Health / hum.MaxHealth) * 100
    
    local hl = Instance.new("Highlight")
    hl.FillColor = getHealthColor(hp)
    hl.FillTransparency = 0.55
    hl.OutlineColor = getHealthColor(hp)
    hl.OutlineTransparency = 0.2
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = plr.Character
    hl.Parent = plr.Character
    
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 160, 0, 60)
    bb.StudsOffset = Vector3.new(0, 2.8, 0)
    bb.AlwaysOnTop = true
    bb.Parent = plr.Character
    
    local bg = Instance.new("Frame", bb)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 0.55
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 10)
    
    local name = Instance.new("TextLabel", bg)
    name.Size = UDim2.new(1, 0, 0, 24)
    name.Position = UDim2.new(0, 0, 0, 2)
    name.Text = plr.DisplayName
    name.TextColor3 = Color3.fromRGB(255, 255, 255)
    name.TextSize = 13
    name.Font = Enum.Font.GothamBold
    name.BackgroundTransparency = 1
    
    local user = Instance.new("TextLabel", bg)
    user.Size = UDim2.new(1, 0, 0, 14)
    user.Position = UDim2.new(0, 0, 0, 26)
    user.Text = "(@" .. plr.Name .. ")"
    user.TextColor3 = Color3.fromRGB(180, 180, 180)
    user.TextSize = 9
    user.BackgroundTransparency = 1
    
    local hbBg = Instance.new("Frame", bg)
    hbBg.Size = UDim2.new(0.9, 0, 0, 8)
    hbBg.Position = UDim2.new(0.05, 0, 0, 44)
    hbBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Instance.new("UICorner", hbBg).CornerRadius = UDim.new(0, 4)
    
    local hbFill = Instance.new("Frame", hbBg)
    hbFill.Size = UDim2.new(hp / 100, 0, 1, 0)
    hbFill.BackgroundColor3 = getHealthColor(hp)
    Instance.new("UICorner", hbFill).CornerRadius = UDim.new(0, 4)
    
    local hpText = Instance.new("TextLabel", bg)
    hpText.Size = UDim2.new(1, 0, 0, 14)
    hpText.Position = UDim2.new(0, 0, 0, 54)
    hpText.Text = math.floor(hp) .. "%"
    hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
    hpText.TextSize = 10
    hpText.BackgroundTransparency = 1
    
    espList[plr] = {hl = hl, fill = hbFill, txt = hpText}
    
    local conn = RunService.Heartbeat:Connect(function()
        if not plr.Character or not plr.Character:FindFirstChild("Humanoid") then return end
        local h = plr.Character.Humanoid
        local newHP = (h.Health / h.MaxHealth) * 100
        if espList[plr] then
            espList[plr].fill.Size = UDim2.new(h.Health / h.MaxHealth, 0, 1, 0)
            espList[plr].fill.BackgroundColor3 = getHealthColor(newHP)
            espList[plr].txt.Text = math.floor(newHP) .. "%"
            espList[plr].hl.FillColor = getHealthColor(newHP)
            espList[plr].hl.OutlineColor = getHealthColor(newHP)
        end
    end)
    table.insert(activeConns, conn)
end

local function removeESP()
    for _, d in pairs(espList) do
        if d.hl then pcall(function() d.hl:Destroy() end) end
    end
    espList = {}
end

local function toggleESP()
    espOn = not espOn
    if espOn then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then createESP(p) end
        end
    else
        removeESP()
    end
end

-- ============================================
-- ACTIVATE / DEACTIVATE
-- ============================================
local function deactivate()
    isActive = false
    soloRunning = false
    orbitRunning = false
    feetRunning = false
    for _, c in pairs(activeConns) do pcall(function() c:Disconnect() end) end
    activeConns = {}
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then
        c.Humanoid.WalkSpeed = 16
        c.Humanoid.JumpPower = 50
    end
    if statusLabel then
        statusLabel.Text = "● INACTIVE"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

local function activate()
    if not selectedTarget then
        if statusLabel then statusLabel.Text = "⚠️ NO TARGET" end
        return
    end
    deactivate()
    task.wait(0.1)
    isActive = true
    
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then
        c.Humanoid.WalkSpeed = 180
        c.Humanoid.JumpPower = 120
    end
    
    if statusLabel then
        statusLabel.Text = "● ACTIVE - " .. currentMode .. " → " .. selectedTarget.Name
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    end
    
    if currentMode == "SOLO" then startSolo()
    elseif currentMode == "ORBIT" then startOrbit()
    elseif currentMode == "FEET" then startFeet() end
    
    task.spawn(function()
        while isActive and emergency do
            local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if h and (h.Health / h.MaxHealth) * 100 < 25 then teleportSafe() end
            task.wait(1)
        end
    end)
end

