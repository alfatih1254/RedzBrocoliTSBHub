setupSlider(speedSliderBg, speedSliderFill, speedLabel, 0.3, 3, "⚡ ORBIT SPEED", orbitSpeed)
setupSlider(feetSliderBg, feetSliderFill, feetLabel, 1, 10, "🦶 FEET DISTANCE", feetDist)

