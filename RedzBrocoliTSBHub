        char.Humanoid.WalkSpeed = 180
        char.Humanoid.JumpPower = 120
    end
    if statusLabel then
        statusLabel.Text = "● ACTIVE - " .. currentMode .. " → " .. selectedTarget.Name
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    end
    if currentMode == "SOLO" then startSolo()
    elseif currentMode == "ORBIT" then startOrbit()
    elseif currentMode == "FEET" then startFeet() end
    task.spawn(function()
        while isActive and emergency do
            local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if humanoid and (humanoid.Health / humanoid.MaxHealth) * 100 < 25 then teleportSafe() end
            task.wait(1)
        end
    end)
