        espHighlights[player] = nil
    end
    updateTargetList()
end)

-- KEYBOARD SHORTCUTS
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Insert then
        if selectedTarget then
            activateMode()
        else
            statusText.Text = "⚠️ SELECT TARGET FIRST!"
            pcall(function()
                StarterGui:SetCore("SendNotification", {
                    Title = "⚠️ NO TARGET",
                    Text = "Please click on a player in the list first!",
                    Duration = 2
                })
            end)
        end
    elseif input.KeyCode == Enum.KeyCode.Delete then
        cleanup()
    elseif input.KeyCode == Enum.KeyCode.V then
        toggleGodMode()
    elseif input.KeyCode == Enum.KeyCode.E then
        toggleESP()
    end
end)

-- Character respawn handler
LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    task.wait(0.3)
    if isActive and newCharacter and newCharacter:FindFirstChild("Humanoid") then
        newCharacter.Humanoid.WalkSpeed = 180
        newCharacter.Humanoid.JumpPower = 120
    end
    if godModeEnabled then
        task.wait(0.1)
        applyGodMode()
    end
    if selectedTarget and selectedTarget.Character then
        task.wait(0.2)
        applyHighlightToTarget(selectedTarget)
    end
end)

-- Target respawn handler
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function()
            task.wait(0.3)
            if isActive and selectedTarget == player and player.Character then
                local targetHumanoid = player.Character:FindFirstChild("Humanoid")
                if targetHumanoid then
                    targetHumanoid.WalkSpeed = 0
                    targetHumanoid.JumpPower = 0
                end
            end
            if selectedTarget == player then
                task.wait(0.2)
                applyHighlightToTarget(player)
            end
            if espEnabled then
                task.wait(0.3)
                createESP(player)
            end
        end)
    end
end

-- Animated glow border (rainbow effect)
task.spawn(function()
    while screenGui and screenGui.Parent do
        local hue = (tick() % 3) / 3
        local r = 0.5 + math.sin(hue * math.pi * 2) * 0.3
        local g = 0.2 + math.sin((hue + 0.5) * math.pi * 2) * 0.2
        local b = 0.8 + math.sin((hue + 0.25) * math.pi * 2) * 0.2
        glowBorder.BorderColor3 = Color3.new(r, g, b)
        task.wait(0.05)
    end
end)

