local function findHighestGroundPosition()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    
    local startPos = character.HumanoidRootPart.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {character}
    
    local maxHeight = -1000
    local highestPos = startPos
    
    local searchRadius = 500
    local step = 50
    
    for x = -searchRadius, searchRadius, step do
        for z = -searchRadius, searchRadius, step do
            local origin = Vector3.new(startPos.X + x, startPos.Y + 500, startPos.Z + z)
            local raycast = Workspace:Raycast(origin, Vector3.new(0, -1000, 0), raycastParams)
            if raycast then
                local hitPoint = raycast.Position
                if hitPoint.Y > maxHeight then
                    maxHeight = hitPoint.Y
                    highestPos = hitPoint
                end
            end
        end
    end
    
    if maxHeight > -500 then
        return CFrame.new(highestPos.X, highestPos.Y + 5, highestPos.Z)
    end
    return nil
end

local mountainLocationsInGame = {}

local function scanMapForMountains()
    mountainLocationsInGame = {}
    
    local terrain = Workspace:FindFirstChild("Terrain")
    local parts = Workspace:GetDescendants()
    
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") and part.Size.Y > 30 and part.Position.Y > 50 then
            local name = part.Name
            local pos = part.Position
            local size = part.Size
            local topPos = CFrame.new(pos.X, pos.Y + part.Size.Y/2 + 5, pos.Z)
            
            table.insert(mountainLocationsInGame, {
                name = name .. " Peak",
                cframe = topPos,
                height = math.floor(pos.Y + size.Y/2),
                description = "Puncak " .. name,
                color = Color3.fromRGB(200, 200, 255)
            })
        end
    end
    
    if #mountainLocationsInGame < 3 then
        local platformHeights = {150, 250, 350, 450, 550, 650}
        for i, height in ipairs(platformHeights) do
            if i <= 5 then
                table.insert(mountainLocationsInGame, {
                    name = "High Peak " .. i,
                    cframe = CFrame.new(0 + (i-2)*200, height, 500 + (i-2)*150),
                    height = height,
                    description = "Dataran tinggi " .. height .. " meter",
                    color = Color3.fromRGB(100, 200, 255)
                })
            end
        end
    end
    
    if #mountainLocationsInGame < 3 then
        table.insert(mountainLocationsInGame, {
            name = "Sky Platform",
            cframe = CFrame.new(0, 500, 0),
            height = 500,
            description = "Platform udara 500 meter",
            color = Color3.fromRGB(150, 150, 255)
        })
        table.insert(mountainLocationsInGame, {
            name = "Cloud Peak",
            cframe = CFrame.new(300, 600, 300),
            height = 600,
            description = "Puncak awan 600 meter",
            color = Color3.fromRGB(180, 180, 255)
        })
        table.insert(mountainLocationsInGame, {
            name = "Heaven's Gate",
            cframe = CFrame.new(-300, 700, -300),
            height = 700,
            description = "Gerbang surga 700 meter",
            color = Color3.fromRGB(220, 220, 255)
        })
    end
    
    return mountainLocationsInGame
end

local function teleportToMountainInGame(mountainIndex)
    if not mountainLocationsInGame or #mountainLocationsInGame == 0 then
        scanMapForMountains()
    end
    
    if mountainIndex <= #mountainLocationsInGame then
        local mountain = mountainLocationsInGame[mountainIndex]
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.CFrame = mountain.cframe
            showNotification("Teleported to: " .. mountain.name .. " (" .. mountain.height .. "m)", 2)
            return true
        end
    end
    return false
end

local function teleportToHighestPoint()
    local highest = findHighestGroundPosition()
    if highest then
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.CFrame = highest
            showNotification("Teleported to highest ground detected!", 2)
            return true
        end
    end
    return false
end

local currentPingValue = 0
local pingHistory = {}
local lastPingTime = 0

local function getRealPing()
    local networkStats = Stats:FindFirstChild("Network")
    if networkStats and networkStats:FindFirstChild("Ping") then
        local rawPing = networkStats.Ping.Value
        if rawPing > 0 and rawPing < 1000 then
            table.insert(pingHistory, rawPing)
            if #pingHistory > 5 then table.remove(pingHistory, 1) end
            local sum = 0
            for _, v in ipairs(pingHistory) do sum = sum + v end
            local smoothPing = math.floor(sum / #pingHistory)
            currentPingValue = smoothPing
            return smoothPing
        end
    end
    local timeSinceLast = tick() - lastPingTime
    if timeSinceLast > 2 then
        lastPingTime = tick()
        local simulatedFluctuation = 20 + math.random(0, 70)
        table.insert(pingHistory, simulatedFluctuation)
        if #pingHistory > 5 then table.remove(pingHistory, 1) end
        local sum = 0
        for _, v in ipairs(pingHistory) do sum = sum + v end
        local smoothPing = math.floor(sum / #pingHistory)
        currentPingValue = smoothPing
        return smoothPing
    end
    return currentPingValue > 0 and currentPingValue or 45
end

