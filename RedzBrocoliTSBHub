-- Emergency teleport check (runs automatically)
local function emergencyTeleportCheck()
    if not emergencyEnabled then return false end
    if emergencyTeleported then return false end

    local character = LocalPlayer.Character
    if not character then return false end

    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end

    local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100

    if hpPercent < 25 then
        emergencyTeleported = true

        -- Stop all active mode activities
        if isActive then
            for _, connection in pairs(activeConnections) do
                pcall(function() connection:Disconnect() end)
            end
            activeConnections = {}
            isActive = false
        end

        -- Teleport to safe place
        local success = teleportToSafePlace()

        if success then
            if statusText then
                statusText.Text = "🚨 EMERGENCY: TELEPORTED TO SAFE PLACE!"
            end
            if led then
                led.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
            end

            -- Flash LED effect
            for i = 1, 3 do
                if led then
                    led.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                end
                task.wait(0.1)
                if led then
                    led.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
                end
                task.wait(0.1)
            end

            -- Notification
            pcall(function()
                StarterGui:SetCore("SendNotification", {
                    Title = "🚨 EMERGENCY ESCAPE",
                    Text = "HP below 25%! Teleported to safe location!",
                    Duration = 3
                })
            end)
        end

        -- Reset emergency flag after 10 seconds
        task.delay(10, function()
            emergencyTeleported = false
            if not isActive and statusText and led then
                if not godModeEnabled then
                    led.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                end
                statusText.Text = "MODE: INACTIVE | TARGET: " .. (selectedTarget and selectedTarget.Name or "NONE")
            end
        end)

        return true
    end

    return false
end

