-- Function to apply Godmode effects (ForceField + Particles)
local function applyGodMode()
    local character = LocalPlayer.Character
    if not character then return false end

    -- Remove old ForceField if exists
    if currentForceField then
        pcall(function() currentForceField:Destroy() end)
        currentForceField = nil
    end

    -- Create new ForceField (Blue shield)
    currentForceField = Instance.new("ForceField")
    currentForceField.Name = "Redz_GodMode_ForceField"
    currentForceField.Parent = character

    -- Create particle effects for visual flair
    local particleEmitter = Instance.new("ParticleEmitter")
    particleEmitter.Name = "Redz_GodMode_Particles"
    particleEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    particleEmitter.Color = ColorSequence.new(
        Color3.fromRGB(0, 150, 255),
        Color3.fromRGB(255, 50, 150),
        Color3.fromRGB(0, 200, 255)
    )
    particleEmitter.Size = NumberSequence.new(0.5)
    particleEmitter.Rate = 50
    particleEmitter.Lifetime = NumberRange.new(0.6)
    particleEmitter.SpreadAngle = Vector2.new(360, 360)
    particleEmitter.VelocityInheritance = 0
    particleEmitter.Speed = NumberRange.new(4)
    particleEmitter.Enabled = true

    -- Attach particles to HumanoidRootPart or character
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if rootPart then
        particleEmitter.Parent = rootPart
    else
        particleEmitter.Parent = character
    end

    -- Anti ragdoll and invincibility
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.BreakJointsOnDeath = false
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
    end

    return true
end

-- Function to remove Godmode effects
local function removeGodMode()
    -- Remove ForceField
    if currentForceField then
        pcall(function() currentForceField:Destroy() end)
        currentForceField = nil
    end

    -- Remove particles
    local character = LocalPlayer.Character
    if character then
        -- Remove all ForceFields
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("ForceField") then
                child:Destroy()
            end
        end

        -- Remove particles
        for _, descendant in ipairs(character:GetDescendants()) do
            if descendant.Name == "Redz_GodMode_Particles" then
                descendant:Destroy()
            end
        end

        -- Restore humanoid properties
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.BreakJointsOnDeath = true
        end
    end
end

-- Function to keep Godmode alive (prevents it from being removed by game)
local function keepGodModeAlive()
    task.spawn(function()
        while screenGui and screenGui.Parent and godModeEnabled do
            local character = LocalPlayer.Character
            if character then
                -- Check if ForceField exists, if not recreate it
                local hasForceField = false
                for _, child in ipairs(character:GetChildren()) do
                    if child:IsA("ForceField") and child.Name == "Redz_GodMode_ForceField" then
                        hasForceField = true
                        currentForceField = child
                        break
                    end
                end

                if not hasForceField then
                    currentForceField = Instance.new("ForceField")
                    currentForceField.Name = "Redz_GodMode_ForceField"
                    currentForceField.Parent = character
                end

                -- Anti ragdoll check
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid then
                    humanoid.BreakJointsOnDeath = false
                    if humanoid.PlatformStand then
                        humanoid.PlatformStand = false
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end

-- Toggle Godmode function
local function toggleGodMode()
    godModeEnabled = not godModeEnabled

    if godModeEnabled then
        applyGodMode()
        keepGodModeAlive()

        if godModeBtn then
            godModeBtn.Text = "🛡️ GODMODE ON"
            godModeBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        end
        if godModeStatus then
            godModeStatus.Text = "⚡ ACTIVE - BLUE SHIELD ⚡"
            godModeStatus.TextColor3 = Color3.fromRGB(0, 255, 200)
        end

        -- Notification
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "🛡️ GODMODE ACTIVATED",
                Text = "You are now invincible! Blue shield protects you.",
                Duration = 2
            })
        end)
    else
        removeGodMode()

        if godModeBtn then
            godModeBtn.Text = "🛡️ GODMODE OFF"
            godModeBtn.BackgroundColor3 = Color3.fromRGB(100, 50, 150)
        end
        if godModeStatus then
            godModeStatus.Text = "○ INACTIVE ○"
