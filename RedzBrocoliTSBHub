                if s.var == "soloRadius" then soloRadius = val
                elseif s.var == "orbitRadius" then orbitRadius = val
                elseif s.var == "orbitSpeed" then orbitSpeed = val
                elseif s.var == "feetDist" then feetDist = val end
                saveConfig()
            end
        end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local pos = math.clamp((i.Position.X - bg.AbsolutePosition.X)/bg.AbsoluteSize.X, 0, 1)
                local val = s.min + pos * (s.max - s.min)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                label.Text = s.label..": "..string.format("%.1f", val)
                if s.var == "soloRadius" then soloRadius = val
                elseif s.var == "orbitRadius" then orbitRadius = val
                elseif s.var == "orbitSpeed" then orbitSpeed = val
                elseif s.var == "feetDist" then feetDist = val end
                saveConfig()
            end
        end)
        local initPos = (s.default - s.min) / (s.max - s.min)
        fill.Size = UDim2.new(initPos, 0, 1, 0)
        label.Text = s.label..": "..string.format("%.1f", s.default)
        if s.var == "soloRadius" then soloRadius = s.default
        elseif s.var == "orbitRadius" then orbitRadius = s.default
        elseif s.var == "orbitSpeed" then orbitSpeed = s.default
        elseif s.var == "feetDist" then feetDist = s.default end
    end
