local function createModernSlider(parent, xPos, yPos, sliderWidth, minVal, maxVal, defaultVal, callback, labelText, sliderColor)
    local container = Instance.new("Frame", parent)
    container.Size = UDim2.new(0, sliderWidth + 40, 0, 60)
    container.Position = UDim2.new(0, xPos, 0, yPos)
    container.BackgroundTransparency = 1
    
    local label = Instance.new("TextLabel", container)
    label.Size = UDim2.new(1, 0, 0, 24)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.Text = labelText
    label.TextColor3 = sliderColor or Color3.fromRGB(200, 200, 255)
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    
    local valueLabel = Instance.new("TextLabel", container)
    valueLabel.Size = UDim2.new(0, 50, 0, 24)
    valueLabel.Position = UDim2.new(1, -50, 0, 0)
    valueLabel.Text = string.format("%.1f", defaultVal)
    valueLabel.TextColor3 = sliderColor or Color3.fromRGB(255, 200, 100)
    valueLabel.TextSize = 12
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.BackgroundTransparency = 1
    valueLabel.Font = Enum.Font.GothamBold
    
    local background = Instance.new("Frame", container)
    background.Size = UDim2.new(1, 0, 0, 6)
    background.Position = UDim2.new(0, 0, 0, 28)
    background.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
    Instance.new("UICorner", background).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame", background)
    fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = sliderColor or Color3.fromRGB(150, 100, 255)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame", background)
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), -9, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    knob.BorderSizePixel = 2
    knob.BorderColor3 = sliderColor or Color3.fromRGB(150, 100, 255)
    
    local isDragging = false
    
    local function updateFromPosition(inputPosition)
        local relativePos = math.clamp((inputPosition - background.AbsolutePosition.X) / background.AbsoluteSize.X, 0, 1)
        local newValue = minVal + relativePos * (maxVal - minVal)
        fill.Size = UDim2.new(relativePos, 0, 1, 0)
        knob.Position = UDim2.new(relativePos, -9, 0.5, -9)
        valueLabel.Text = string.format("%.1f", newValue)
        callback(newValue)
    end
    
    background.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            updateFromPosition(input.Position.X)
        end
    end)
    
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
