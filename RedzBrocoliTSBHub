            -- Update button styles
            for _, btn in ipairs(targetScroll:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.BackgroundColor3 = Color3.fromRGB(40, 15, 80)
                    btn.BackgroundTransparency = 0.45
