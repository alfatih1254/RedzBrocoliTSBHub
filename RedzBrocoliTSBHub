        end

        -- Notification
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "🛡️ GODMODE DEACTIVATED",
                Text = "You are now vulnerable again.",
                Duration = 2
            })
        end)
    end
end

