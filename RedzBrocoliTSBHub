-- ============================================
local function saveCollision()
    local c = LocalPlayer.Character
    if not c then return end
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") and originalCollision[part] == nil then
            originalCollision[part] = part.CanCollide
        end
    end
end

local function applyNoClip()
    local c = LocalPlayer.Character
    if not c then return end
    saveCollision()
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
end

local function removeNoClip()
    local c = LocalPlayer.Character
    if not c then return end
    for part, orig in pairs(originalCollision) do
        if part and part.Parent then part.CanCollide = orig end
    end
    originalCollision = {}
end

local function runNoClip()
    if noclipRunning then return end
    noclipRunning = true
    task.spawn(function()
        while noClip do
            applyNoClip()
            task.wait(0.1)
        end
        removeNoClip()
        noclipRunning = false
    end)
end

