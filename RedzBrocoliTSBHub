    titleLabel.Text = labelText
    titleLabel.TextColor3 = accentColor or Color3.fromRGB(210, 210, 255)
    titleLabel.TextSize = 12
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.Gotham
    
    local valueDisplay = Instance.new("TextLabel", sliderContainer)
    valueDisplay.Size = UDim2.new(0.25, 0, 0, 25)
    valueDisplay.Position = UDim2.new(0.75, 0, 0, 0)
    valueDisplay.Text = string.format("%.1f", defaultValue)
    valueDisplay.TextColor3 = accentColor or Color3.fromRGB(255, 210, 100)
    valueDisplay.TextSize = 13
    valueDisplay.TextXAlignment = Enum.TextXAlignment.Right
    valueDisplay.BackgroundTransparency = 1
    valueDisplay.Font = Enum.Font.GothamBold
    
    local trackBackground = Instance.new("Frame", sliderContainer)
    trackBackground.Size = UDim2.new(1, 0, 0, 6)
    trackBackground.Position = UDim2.new(0, 0, 0, 30)
    trackBackground.BackgroundColor3 = Color3.fromRGB(65, 45, 110)
    Instance.new("UICorner", trackBackground).CornerRadius = UDim.new(1, 0)
    
    local trackFill = Instance.new("Frame", trackBackground)
    trackFill.Size = UDim2.new((defaultValue - minVal) / (maxVal - minVal), 0, 1, 0)
    trackFill.BackgroundColor3 = accentColor or Color3.fromRGB(170, 110, 255)
    Instance.new("UICorner", trackFill).CornerRadius = UDim.new(1, 0)
    
    local controlKnob = Instance.new("Frame", trackBackground)
    controlKnob.Size = UDim2.new(0, 20, 0, 20)
    controlKnob.Position = UDim2.new((defaultValue - minVal) / (maxVal - minVal), -10, 0.5, -10)
    controlKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", controlKnob).CornerRadius = UDim.new(1, 0)
    controlKnob.BorderSizePixel = 2
    controlKnob.BorderColor3 = accentColor or Color3.fromRGB(170, 110, 255)
    
    local isDraggingKnob = false
    
    local function updateSliderFromPosition(inputX)
        local clampedPos = math.clamp((inputX - trackBackground.AbsolutePosition.X) / trackBackground.AbsoluteSize.X, 0, 1)
        local newSliderValue = minVal + clampedPos * (maxVal - minVal)
        trackFill.Size = UDim2.new(clampedPos, 0, 1, 0)
        controlKnob.Position = UDim2.new(clampedPos, -10, 0.5, -10)
        valueDisplay.Text = string.format("%.1f", newSliderValue)
        onChange(newSliderValue)
    end
    
    trackBackground.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingKnob = true
            updateSliderFromPosition(input.Position.X)
        end
    end)
    
    controlKnob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingKnob = true
            updateSliderFromPosition(input.Position.X)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDraggingKnob = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isDraggingKnob and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSliderFromPosition(input.Position.X)
        end
    end)
end

