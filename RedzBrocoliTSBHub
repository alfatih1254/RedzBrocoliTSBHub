local function storeOriginalCollision()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and originalCollisionStates[part] == nil then
            originalCollisionStates[part] = part.CanCollide
        end
    end
end

local function activateNoclip()
    local char = LocalPlayer.Character
    if not char then return end
    storeOriginalCollision()
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
end

local function deactivateNoclip()
    local char = LocalPlayer.Character
    if not char then return end
    for part, orig in pairs(originalCollisionStates) do
        if part and part.Parent then part.CanCollide = orig end
    end
    originalCollisionStates = {}
end

