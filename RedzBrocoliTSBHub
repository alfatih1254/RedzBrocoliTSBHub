            if c and c:FindFirstChild("HumanoidRootPart") and t and t:FindFirstChild("HumanoidRootPart") then
                orbitAngle = orbitAngle + orbitSpeed * 0.05
                local tp = t.HumanoidRootPart.Position
                local np = Vector3.new(tp.X + math.cos(orbitAngle)*orbitRadius, tp.Y + 2, tp.Z + math.sin(orbitAngle)*orbitRadius)
