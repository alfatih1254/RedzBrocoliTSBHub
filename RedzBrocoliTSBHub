-- ============================================
-- SOLO MODE
-- ============================================
local function startSolo()
    task.spawn(function()
        while isActive and currentMode == "SOLO" and selectedTarget and selectedTarget.Character do
            local c, t = LocalPlayer.Character, selectedTarget.Character
            if c and c:FindFirstChild("HumanoidRootPart") and t and t:FindFirstChild("HumanoidRootPart") then
                local tp = t.HumanoidRootPart.Position
                local a = math.random() * 2 * math.pi
                local np = Vector3.new(tp.X + math.cos(a)*soloRadius, tp.Y + math.random(1,4), tp.Z + math.sin(a)*soloRadius)
                c.HumanoidRootPart.CFrame = CFrame.new(np, tp)
                if autoCombo then pcall(function() VirtualUser:ClickButton1(Vector2.new(500,500),1) end) end
                if instantKill then local h = t:FindFirstChild("Humanoid") if h and h.Health>0 then h.Health=0 end end
            end
            task.wait(0.05)
        end
    end)
end

