local function showNotification(message, duration)
    table.insert(notificationQueue, {msg = message, dur = duration or 3})
    
    if isNotifying then return end
    
    local function processQueue()
        if #notificationQueue == 0 then
            isNotifying = false
            if notificationFrame then
                notificationFrame.Visible = false
            end
            return
        end
        
        isNotifying = true
        local notif = table.remove(notificationQueue, 1)
        
        if not notificationFrame or not notificationFrame.Parent then
            if screenGui then
                notificationFrame = Instance.new("Frame", screenGui)
                notificationFrame.Size = UDim2.new(0, 350, 0, 60)
                notificationFrame.Position = UDim2.new(0.5, -175, 0, 50)
                notificationFrame.BackgroundColor3 = Color3.fromRGB(20, 15, 45)
                notificationFrame.BackgroundTransparency = 0.15
                notificationFrame.BorderSizePixel = 1
                notificationFrame.BorderColor3 = Color3.fromRGB(150, 100, 255)
                Instance.new("UICorner", notificationFrame).CornerRadius = UDim.new(0, 16)
                
                notificationText = Instance.new("TextLabel", notificationFrame)
                notificationText.Size = UDim2.new(1, -20, 1, 0)
                notificationText.Position = UDim2.new(0, 10, 0, 0)
                notificationText.Text = ""
                notificationText.TextColor3 = Color3.fromRGB(255, 255, 255)
                notificationText.TextSize = 14
                notificationText.Font = Enum.Font.Gotham
                notificationText.TextWrapped = true
                notificationText.BackgroundTransparency = 1
                notificationFrame.Visible = false
            end
        end
        
        notificationFrame.Visible = true
        notificationText.Text = notif.msg
        
        local goal = {BackgroundTransparency = 0.25}
        local tween = TweenService:Create(notificationFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
        tween:Play()
        
        task.wait(notif.dur)
        
        local goal2 = {BackgroundTransparency = 1}
        local tween2 = TweenService:Create(notificationFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), goal2)
        tween2:Play()
        tween2.Completed:Wait()
        
        notificationFrame.Visible = false
        processQueue()
    end
    
    task.spawn(processQueue)
end

