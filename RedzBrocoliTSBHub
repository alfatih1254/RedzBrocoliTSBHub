-- ============================================
-- ACTIVATE / DEACTIVATE
-- ============================================
local function stopAllLoops()
    comboLoopRunning = false
    killLoopRunning = false
    blockLoopRunning = false
    soloLoopRunning = false
    orbitLoopRunning = false
    feetLoopRunning = false
end

local function deactivate()
    isActive = false
    stopAllLoops()
    for _, c in pairs(activeConns) do pcall(function() c:Disconnect() end) end
    activeConns = {}
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then
        c.Humanoid.WalkSpeed = 16
        c.Humanoid.JumpPower = 50
    end
    if statusLabel then
        statusLabel.Text = "📌 STATUS: INACTIVE"
        statusLabel.TextColor3 = Color3.fromRGB(255,100,100)
    end
end

local function activate()
    if not selectedTarget then
        if statusLabel then statusLabel.Text = "⚠️ SELECT TARGET FIRST!" end
        return
    end
    deactivate()
    task.wait(0.1)
    isActive = true
    orbitAngle = 0
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then
        c.Humanoid.WalkSpeed = 180
        c.Humanoid.JumpPower = 120
    end
    if statusLabel then
        statusLabel.Text = "📌 STATUS: ACTIVE - MODE: "..currentMode.." - TARGET: "..selectedTarget.Name
        statusLabel.TextColor3 = Color3.fromRGB(0,255,100)
    end
    
    if currentMode == "SOLO" then startSoloMode()
    elseif currentMode == "ORBIT" then startOrbitMode()
    elseif currentMode == "FEET" then startFeetMode() end
    
    if autoCombo then startAutoCombo() end
    if instantKill then startInstantKill() end
    if autoBlock then startAutoBlock() end
    
    task.spawn(function()
        while isActive do
            emergencyCheck()
            task.wait(1)
        end
    end)
end

