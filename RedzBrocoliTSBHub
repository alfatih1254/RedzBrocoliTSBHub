    if highlightConnection then pcall(function() highlightConnection:Disconnect() end) end
end

local function applyHighlightToTarget(target)
    removeHighlight()
    if not target or not target.Character then return end
    
    local character = target.Character
    local highlight = Instance.new("Highlight")
    highlight.Name = "Redz_Target_HL"
    highlight.FillColor = Color3.fromRGB(255, 0, 255)
    highlight.FillTransparency = 0.35
    highlight.OutlineColor = Color3.fromRGB(255, 100, 255)
    highlight.OutlineTransparency = 0.15
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character
    currentHighlight = highlight
    
    highlightConnection = target.CharacterAdded:Connect(function(newCharacter)
        task.wait(0.2)
        if selectedTarget == target then
            if currentHighlight then pcall(function() currentHighlight:Destroy() end) end
            local newHighlight = Instance.new("Highlight")
            newHighlight.Name = "Redz_Target_HL"
            newHighlight.FillColor = Color3.fromRGB(255, 0, 255)
            newHighlight.FillTransparency = 0.35
            newHighlight.OutlineColor = Color3.fromRGB(255, 100, 255)
            newHighlight.OutlineTransparency = 0.15
            newHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            newHighlight.Adornee = newCharacter
            newHighlight.Parent = newCharacter
            currentHighlight = newHighlight
        end
    end)
end

