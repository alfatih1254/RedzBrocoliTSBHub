end

local function getPreciseHealthColor(healthPercent)
    if healthPercent >= 100 then return Color3.fromRGB(0, 255, 0)
    elseif healthPercent >= 95 then return Color3.fromRGB(51, 255, 0)
    elseif healthPercent >= 90 then return Color3.fromRGB(102, 255, 0)
    elseif healthPercent >= 85 then return Color3.fromRGB(153, 255, 0)
    elseif healthPercent >= 80 then return Color3.fromRGB(204, 255, 0)
    elseif healthPercent >= 75 then return Color3.fromRGB(255, 255, 0)
    elseif healthPercent >= 70 then return Color3.fromRGB(255, 229, 0)
    elseif healthPercent >= 65 then return Color3.fromRGB(255, 204, 0)
    elseif healthPercent >= 60 then return Color3.fromRGB(255, 178, 0)
    elseif healthPercent >= 55 then return Color3.fromRGB(255, 153, 0)
    elseif healthPercent >= 50 then return Color3.fromRGB(255, 127, 0)
    elseif healthPercent >= 45 then return Color3.fromRGB(255, 102, 0)
    elseif healthPercent >= 40 then return Color3.fromRGB(255, 76, 0)
    elseif healthPercent >= 35 then return Color3.fromRGB(255, 51, 0)
    elseif healthPercent >= 30 then return Color3.fromRGB(255, 25, 0)
    elseif healthPercent >= 25 then return Color3.fromRGB(255, 0, 0)
    elseif healthPercent >= 20 then return Color3.fromRGB(204, 0, 0)
    elseif healthPercent >= 15 then return Color3.fromRGB(153, 0, 0)
    elseif healthPercent >= 10 then return Color3.fromRGB(102, 0, 0)
    elseif healthPercent >= 5 then return Color3.fromRGB(51, 0, 0)
    else return Color3.fromRGB(25, 0, 0)
    end
end

local function lerpColor(color1, color2, t)
    return Color3.new(
        color1.R + (color2.R - color1.R) * t,
        color1.G + (color2.G - color1.G) * t,
        color1.B + (color2.B - color1.B) * t
    )
end

local function getSmoothHealthColor(healthPercent)
    if healthPercent >= 80 then
        local t = (healthPercent - 80) / 20
        return lerpColor(Color3.fromRGB(204, 255, 0), Color3.fromRGB(0, 255, 0), t)
    elseif healthPercent >= 60 and healthPercent < 80 then
        local t = (healthPercent - 60) / 20
        return lerpColor(Color3.fromRGB(255, 178, 0), Color3.fromRGB(204, 255, 0), t)
    elseif healthPercent >= 40 and healthPercent < 60 then
        local t = (healthPercent - 40) / 20
        return lerpColor(Color3.fromRGB(255, 76, 0), Color3.fromRGB(255, 178, 0), t)
    elseif healthPercent >= 20 and healthPercent < 40 then
        local t = (healthPercent - 20) / 20
        return lerpColor(Color3.fromRGB(153, 0, 0), Color3.fromRGB(255, 76, 0), t)
    else
        local t = healthPercent / 20
        return lerpColor(Color3.fromRGB(25, 0, 0), Color3.fromRGB(153, 0, 0), t)
    end
end

