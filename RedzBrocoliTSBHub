local function setupSlider(sliderBg, sliderFill, valueLabel, minValue, maxValue, callback, initialValue)
    local dragging = false

    local function updateSlider(input)
        local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        sliderFill.Size = UDim2.new(pos, 0, 1, 0)
        local value = minValue + (maxValue - minValue) * pos
        valueLabel.Text = string.format("%.1f", value)
        callback(value)
    end

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)

    -- Set initial position
    local initialPos = (initialValue - minValue) / (maxValue - minValue)
    sliderFill.Size = UDim2.new(initialPos, 0, 1, 0)
    valueLabel.Text = string.format("%.1f", initialValue)
    callback(initialValue)
end

-- Setup all sliders
