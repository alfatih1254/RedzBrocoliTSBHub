    userName.Position = UDim2.new(0, 0, 0, 26)
    userName.Text = "(@" .. player.Name .. ")"
    userName.TextColor3 = Color3.fromRGB(180, 180, 180)
    userName.TextSize = 9
    userName.BackgroundTransparency = 1
    
    local healthBarBg = Instance.new("Frame", background)
    healthBarBg.Size = UDim2.new(0.9, 0, 0, 8)
    healthBarBg.Position = UDim2.new(0.05, 0, 0, 44)
    healthBarBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    Instance.new("UICorner", healthBarBg).CornerRadius = UDim.new(0, 4)
    
    local healthBarFill = Instance.new("Frame", healthBarBg)
    healthBarFill.Size = UDim2.new(currentHealth / 100, 0, 1, 0)
    healthBarFill.BackgroundColor3 = getHealthColor(currentHealth)
    Instance.new("UICorner", healthBarFill).CornerRadius = UDim.new(0, 4)
    
    local healthText = Instance.new("TextLabel", background)
    healthText.Size = UDim2.new(1, 0, 0, 14)
    healthText.Position = UDim2.new(0, 0, 0, 54)
    healthText.Text = math.floor(currentHealth) .. "%"
    healthText.TextColor3 = Color3.fromRGB(255, 255, 255)
    healthText.TextSize = 10
    healthText.BackgroundTransparency = 1
    
    espList[player] = {hl = highlight, fill = healthBarFill, txt = healthText}
    
    local connection = RunService.Heartbeat:Connect(function()
        if not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
        local humanoidObj = player.Character.Humanoid
        local newHealthPercent = (humanoidObj.Health / humanoidObj.MaxHealth) * 100
        if espList[player] then
            espList[player].fill.Size = UDim2.new(humanoidObj.Health / humanoidObj.MaxHealth, 0, 1, 0)
            espList[player].fill.BackgroundColor3 = getHealthColor(newHealthPercent)
            espList[player].txt.Text = math.floor(newHealthPercent) .. "%"
            espList[player].hl.FillColor = getHealthColor(newHealthPercent)
            espList[player].hl.OutlineColor = getHealthColor(newHealthPercent)
        end
    end)
    table.insert(activeConns, connection)
end

