local function createAdvancedSlider(parent, startX, startY, width, minVal, maxVal, defaultValue, onChange, labelText, accentColor)
    local sliderContainer = Instance.new("Frame", parent)
    sliderContainer.Size = UDim2.new(0, width + 50, 0, 65)
    sliderContainer.Position = UDim2.new(0, startX, 0, startY)
    sliderContainer.BackgroundTransparency = 1
    
