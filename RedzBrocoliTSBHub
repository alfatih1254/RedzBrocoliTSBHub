local function updateESPForPlayer(player)
    if not espList[player] then return end
    if not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
    local humanoidObj = player.Character.Humanoid
    local healthPercent = (humanoidObj.Health / humanoidObj.MaxHealth) * 100
    local preciseColor = getSmoothHealthColor(healthPercent)
    if espList[player].fill then
        espList[player].fill.Size = UDim2.new(humanoidObj.Health / humanoidObj.MaxHealth, 0, 1, 0)
        espList[player].fill.BackgroundColor3 = preciseColor
    end
    if espList[player].txt then
        espList[player].txt.Text = string.format("%.1f%%", healthPercent)
    end
    if espList[player].hl then
        espList[player].hl.FillColor = preciseColor
        espList[player].hl.OutlineColor = preciseColor
        espList[player].hl.FillTransparency = 0.45
        espList[player].hl.OutlineTransparency = 0.15
    end
    if espList[player].dist and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("HumanoidRootPart") then
        local distance = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
        local distanceColor = distance < 20 and Color3.fromRGB(255, 50, 50) or (distance < 50 and Color3.fromRGB(255, 200, 50) or Color3.fromRGB(100, 255, 100))
        espList[player].dist.Text = math.floor(distance) .. "m"
        espList[player].dist.TextColor3 = distanceColor
    end
end

