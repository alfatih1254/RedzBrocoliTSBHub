-- Function to find the safest position (farthest from all players)
local function findSafestPosition()
    local players = Players:GetPlayers()
    local bestPosition = safePositions[1]
    local bestDistance = 0

    for _, pos in ipairs(safePositions) do
        local minDistanceToPlayer = math.huge

        for _, player in ipairs(players) do
            if player ~= LocalPlayer then
                local character = player.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local rootPart = character.HumanoidRootPart
                    local distance = (pos - rootPart.Position).Magnitude
                    if distance < minDistanceToPlayer then
                        minDistanceToPlayer = distance
                    end
                end
            end
        end

        if minDistanceToPlayer > bestDistance then
            bestDistance = minDistanceToPlayer
            bestPosition = pos
        end
    end

    return bestPosition
end

-- Function to teleport to safe place
local function teleportToSafePlace()
    local character = LocalPlayer.Character
    if not character then return false end

    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return false end

    local safePos = findSafestPosition()
    humanoidRootPart.CFrame = CFrame.new(safePos)

    -- Optional: Add visual effect for teleport
    local teleportEffect = Instance.new("Part")
    teleportEffect.Size = Vector3.new(5, 1, 5)
    teleportEffect.Position = safePos - Vector3.new(0, 3, 0)
    teleportEffect.Anchored = true
    teleportEffect.CanCollide = false
    teleportEffect.Transparency = 0.5
    teleportEffect.BrickColor = BrickColor.new("Bright violet")
    teleportEffect.Parent = Workspace

    TweenService:Create(teleportEffect, TweenInfo.new(0.5), {Transparency = 1}):Play()
    task.delay(0.5, function()
        teleportEffect:Destroy()
    end)

    return true
end

