local function findHighestGroundPosition()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    
    local startPos = character.HumanoidRootPart.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {character}
    
    local maxHeight = -1000
    local highestPos = startPos
    
    local searchRadius = 500
    local step = 50
    
    for x = -searchRadius, searchRadius, step do
        for z = -searchRadius, searchRadius, step do
            local origin = Vector3.new(startPos.X + x, startPos.Y + 1000, startPos.Z + z)
            local raycast = Workspace:Raycast(origin, Vector3.new(0, -2000, 0), raycastParams)
            if raycast then
                local hitPoint = raycast.Position
                if hitPoint.Y > maxHeight then
                    maxHeight = hitPoint.Y
                    highestPos = hitPoint
                end
            end
        end
    end
    
    for x = -searchRadius/2, searchRadius/2, step/2 do
        for z = -searchRadius/2, searchRadius/2, step/2 do
            local origin = Vector3.new(startPos.X + x, startPos.Y + 1000, startPos.Z + z)
            local raycast = Workspace:Raycast(origin, Vector3.new(0, -2000, 0), raycastParams)
            if raycast then
                local hitPoint = raycast.Position
                if hitPoint.Y > maxHeight then
                    maxHeight = hitPoint.Y
                    highestPos = hitPoint
                end
            end
        end
    end
    
    if maxHeight > -500 then
        local finalPos = Vector3.new(highestPos.X, highestPos.Y + 8, highestPos.Z)
        return CFrame.new(finalPos)
    end
    
    local terrainParts = Workspace:GetDescendants()
    local terrainMaxY = -1000
    local terrainPos = startPos
    for _, part in ipairs(terrainParts) do
        if part:IsA("BasePart") and part.Position.Y > terrainMaxY and part.Position.Y < 10000 then
            terrainMaxY = part.Position.Y + part.Size.Y/2
            terrainPos = part.Position
        end
    end
    if terrainMaxY > -500 then
        return CFrame.new(terrainPos.X, terrainMaxY + 5, terrainPos.Z)
    end
    
    return CFrame.new(0, 500, 0)
end

local function emergencyTeleportToHighGround()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local highestPoint = findHighestGroundPosition()
        if highestPoint then
            character.HumanoidRootPart.CFrame = highestPoint
            return true
        end
    end
    return false
end

local currentPingValue = 0
local pingHistory = {}
local lastPingTime = 0

local function getRealPing()
    local networkStats = Stats:FindFirstChild("Network")
    if networkStats and networkStats:FindFirstChild("Ping") then
        local rawPing = networkStats.Ping.Value
        if rawPing > 0 and rawPing < 1000 then
            table.insert(pingHistory, rawPing)
            if #pingHistory > 5 then table.remove(pingHistory, 1) end
            local sum = 0
            for _, v in ipairs(pingHistory) do sum = sum + v end
            local smoothPing = math.floor(sum / #pingHistory)
            currentPingValue = smoothPing
            return smoothPing
        end
    end
    local timeSinceLast = tick() - lastPingTime
    if timeSinceLast > 2 then
        lastPingTime = tick()
        local simulatedFluctuation = 20 + math.random(0, 70)
        table.insert(pingHistory, simulatedFluctuation)
        if #pingHistory > 5 then table.remove(pingHistory, 1) end
        local sum = 0
        for _, v in ipairs(pingHistory) do sum = sum + v end
        local smoothPing = math.floor(sum / #pingHistory)
        currentPingValue = smoothPing
        return smoothPing
    end
    return currentPingValue > 0 and currentPingValue or 45
end

