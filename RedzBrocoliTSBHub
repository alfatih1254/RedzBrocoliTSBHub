local function runSpeedHack()
    if speedRunning then return end
    speedRunning = true
    task.spawn(function()
        while speedHack do
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = 16 * speedMultiplier
                char.Humanoid.JumpPower = 50 * math.min(speedMultiplier, 2)
            end
            task.wait(0.15)
        end
        speedRunning = false
