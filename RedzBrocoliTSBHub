    local qualityIcon = ping < 50 and "⚡" or (ping < 100 and "🌐" or "🐌")
    return string.format("%s %s %s [%dms] %s | IP: %s | %s", 
        region.flag, region.name, qualityIcon, ping, pingColor, region.ip, region.region)
end

