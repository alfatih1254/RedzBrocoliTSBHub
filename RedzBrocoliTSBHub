local function applyConfig(config)
    autoCombo = config.autoCombo
    instantKill = config.instantKill
    autoBlock = config.autoBlock
    speedHack = config.speedHack
    speedHackMultiplier = config.speedHackMultiplier
    noClip = config.noClip
    infiniteJump = config.infiniteJump
    teleportTarget = config.teleportTarget
    espOn = config.espOn
    chams = config.chams
    godMode = config.godMode
    emergency = config.emergency
    soloRadius = config.soloRadius
    orbitRadius = config.orbitRadius
    orbitSpeed = config.orbitSpeed
    feetDist = config.feetDist
    currentMode = config.currentMode
    if espOn then
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then createESP(p) end end
    end
    if godMode then toggleGodMode() end
    if speedHack then runSpeedHack() end
    if noClip then runNoClip() else removeNoClip() end
    if chams then runChams() end
    if teleportTarget then runTeleportTarget() end
    updateAllUIButtons()
end

local function resetToDefault()
    applyConfig(defaultConfig)
    saveConfig()
    updateAllUIButtons()
end

