local function setupSlider(bg, fill, valLabel, minV, maxV, callback, initialVal)
    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        local val = minV + (maxV - minV) * pos
        valLabel.Text = string.format("%.1f", val)
        callback(val)
    end
    
    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
    end)
    
    local initPos = (initialVal - minV) / (maxV - minV)
    fill.Size = UDim2.new(initPos, 0, 1, 0)
    valLabel.Text = string.format("%.1f", initialVal)
    callback(initialVal)
end

