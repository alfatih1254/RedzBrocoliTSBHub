-- Function to get color based on health percentage
local function getHealthColor(healthPercent)
    if healthPercent >= 75 then
        return Color3.fromRGB(0, 255, 0)      -- Hijau (75-100%)
    elseif healthPercent >= 50 then
        return Color3.fromRGB(255, 255, 0)    -- Kuning (50-75%)
    elseif healthPercent >= 25 then
        return Color3.fromRGB(255, 165, 0)    -- Orange (25-50%)
    else
        return Color3.fromRGB(255, 0, 0)      -- Merah (0-25%)
    end
end

-- Function to create ESP for a player
local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    
    -- Hapus ESP lama jika ada
    if espHighlights[player] then
        if espHighlights[player].highlight then
            espHighlights[player].highlight:Destroy()
        end
        if espHighlights[player].billboard then
            espHighlights[player].billboard:Destroy()
        end
        espHighlights[player] = nil
    end
    
    -- Tunggu karakter ada
    if not player.Character then return end
    
    local character = player.Character
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    -- Buat Highlight untuk outline
    local highlight = Instance.new("Highlight")
    highlight.Name = "Redz_ESP_Highlight"
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0.2
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character
    
    -- Buat BillboardGui untuk health bar dan nama
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "Redz_ESP_Billboard"
    billboard.Size = UDim2.new(0, 120, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = character
    
    -- Frame utama untuk background
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(1, 0, 1, 0)
    mainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    mainFrame.BackgroundTransparency = 0.5
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = billboard
    
    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = UDim.new(0, 6)
    mainCorner.Parent = mainFrame
    
    -- Nama player
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.Position = UDim2.new(0, 0, 0, 0)
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.BackgroundTransparency = 1
    nameLabel.Parent = mainFrame
    
    -- Health bar background
    local healthBg = Instance.new("Frame")
    healthBg.Size = UDim2.new(0.9, 0, 0, 10)
    healthBg.Position = UDim2.new(0.05, 0, 0, 22)
    healthBg.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    healthBg.BorderSizePixel = 0
    healthBg.Parent = mainFrame
    
    local healthBgCorner = Instance.new("UICorner")
    healthBgCorner.CornerRadius = UDim.new(0, 4)
    healthBgCorner.Parent = healthBg
    
    -- Health bar fill
    local healthFill = Instance.new("Frame")
    healthFill.Size = UDim2.new(1, 0, 1, 0)
    healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthFill.BorderSizePixel = 0
    healthFill.Parent = healthBg
    
    local healthFillCorner = Instance.new("UICorner")
    healthFillCorner.CornerRadius = UDim.new(0, 4)
    healthFillCorner.Parent = healthFill
    
    -- Health text
    local healthText = Instance.new("TextLabel")
    healthText.Size = UDim2.new(1, 0, 0, 16)
    healthText.Position = UDim2.new(0, 0, 0, 34)
    healthText.Text = "100%"
    healthText.TextColor3 = Color3.fromRGB(255, 255, 255)
    healthText.TextSize = 10
    healthText.Font = Enum.Font.Gotham
    healthText.BackgroundTransparency = 1
    healthText.Parent = mainFrame
    
    -- Store ESP data
    espHighlights[player] = {
        highlight = highlight,
        billboard = billboard,
        healthFill = healthFill,
        healthText = healthText,
        nameLabel = nameLabel
    }
    
    -- Update health bar periodically
    local updateConnection = RunService.Heartbeat:Connect(function()
        if not player.Character or not player.Character:FindFirstChild("Humanoid") then
            -- Jika karakter tidak ada, tunggu respawn
            return
        end
        
        local currentHumanoid = player.Character.Humanoid
        local health = currentHumanoid.Health
        local maxHealth = currentHumanoid.MaxHealth
        local healthPercent = (health / maxHealth) * 100
        local fillPercent = math.clamp(health / maxHealth, 0, 1)
        
        -- Update health bar
        if espHighlights[player] and espHighlights[player].healthFill then
            espHighlights[player].healthFill.Size = UDim2.new(fillPercent, 0, 1, 0)
            espHighlights[player].healthFill.BackgroundColor3 = getHealthColor(healthPercent)
            espHighlights[player].healthText.Text = string.format("%.0f%%", healthPercent)
            
            -- Update highlight color berdasarkan health
            if espHighlights[player].highlight then
                espHighlights[player].highlight.FillColor = getHealthColor(healthPercent)
                espHighlights[player].highlight.FillTransparency = 0.5
                espHighlights[player].highlight.OutlineColor = getHealthColor(healthPercent)
                espHighlights[player].highlight.OutlineTransparency = 0.1
            end
        end
    end)
    
    -- Store connection for cleanup
    table.insert(espConnections, updateConnection)
    
    -- Handle character respawn
    local respawnConnection = player.CharacterAdded:Connect(function(newCharacter)
        task.wait(0.2)
        if espEnabled then
            createESPForPlayer(player)
        end
    end)
    table.insert(espConnections, respawnConnection)
end

-- Function to remove all ESP
local function removeAllESP()
    for player, data in pairs(espHighlights) do
        if data.highlight then
            pcall(function() data.highlight:Destroy() end)
        end
        if data.billboard then
            pcall(function() data.billboard:Destroy() end)
        end
    end
    espHighlights = {}
    
    for _, conn in pairs(espConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espConnections = {}
end

