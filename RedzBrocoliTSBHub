sliderLabel.Size, sliderLabel.Position, sliderLabel.Text, sliderLabel.TextColor3 = UDim2.new(0,150,0,20), UDim2.new(0,10,0,370), "📍 TELEPORT RADIUS: 5.0", Color3.fromRGB(255,100,200)
sliderLabel.BackgroundTransparency = 1

local sliderBg = Instance.new("Frame", right)
sliderBg.Size, sliderBg.Position = UDim2.new(0,150,0,5), UDim2.new(0,10,0,393)
sliderBg.BackgroundColor3 = Color3.fromRGB(60,40,100)

local sliderFill = Instance.new("Frame", sliderBg)
sliderFill.Size, sliderFill.BackgroundColor3 = UDim2.new(0.3,0,1,0), Color3.fromRGB(255,50,150)

local dragging = false
sliderBg.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        local pos = math.clamp((i.Position.X - sliderBg.AbsolutePosition.X)/sliderBg.AbsoluteSize.X,0,1)
        soloRadius = 2 + pos * 10
        sliderFill.Size = UDim2.new(pos,0,1,0)
        sliderLabel.Text = "📍 TELEPORT RADIUS: "..string.format("%.1f",soloRadius)
    end
end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end end)
UserInputService.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local pos = math.clamp((i.Position.X - sliderBg.AbsolutePosition.X)/sliderBg.AbsoluteSize.X,0,1)
        soloRadius = 2 + pos * 10
        sliderFill.Size = UDim2.new(pos,0,1,0)
        sliderLabel.Text = "📍 TELEPORT RADIUS: "..string.format("%.1f",soloRadius)
    end
end)

-- Movement toggles (di kiri)
local moveFrame = Instance.new("Frame", left)
moveFrame.Size, moveFrame.Position, moveFrame.BackgroundTransparency = UDim2.new(0.95,0,0,250), UDim2.new(0.025,0,0,10), 1

local moveItems = {
    {name="SPEED HACK", var="speedHack", default=false},
    {name="NO CLIP", var="noClip", default=false},
    {name="INFINITE JUMP", var="infiniteJump", default=false},
    {name="TELEPORT TO TARGET", var="teleportTarget", default=false},
}
local mY = 0
for _, item in ipairs(moveItems) do
    local btn = Instance.new("TextButton", moveFrame)
    btn.Size, btn.Position, btn.Text = UDim2.new(0.95,0,0,30), UDim2.new(0,0,0,mY), (item.default and "[🔘] " or "[⚪] ")..item.name
    btn.TextColor3, btn.TextSize, btn.Font = Color3.fromRGB(220,220,255), 11, Enum.Font.Gotham
    btn.BackgroundColor3 = item.default and Color3.fromRGB(0,120,0) or Color3.fromRGB(60,40,100)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    local varName = item.var
    local state = item.default
    btn.MouseButton1Click:Connect(function()
        state = not state
        if varName == "speedHack" then
            speedHack = state
            if speedHack then runSpeedHack() end
        elseif varName == "noClip" then
            noClip = state
            if noClip then runNoClip() end
        elseif varName == "infiniteJump" then infiniteJump = state
        elseif varName == "teleportTarget" then
            teleportTarget = state
            if teleportTarget then runTeleportTarget() end
        end
        btn.Text = (state and "[🔘] " or "[⚪] ")..item.name
        btn.BackgroundColor3 = state and Color3.fromRGB(0,120,0) or Color3.fromRGB(60,40,100)
    end)
    mY = mY + 35
end

