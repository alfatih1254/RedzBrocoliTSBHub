-- ============================================
-- ACTIVATE/DEACTIVATE
-- ============================================
local function deactivate()
    isActive = false
    for _, c in pairs(activeConns) do pcall(function() c:Disconnect() end) end
    activeConns = {}
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then c.Humanoid.WalkSpeed, c.Humanoid.JumpPower = 16, 50 end
    if statusLabel then statusLabel.Text, statusLabel.TextColor3 = "📌 STATUS: INACTIVE", Color3.fromRGB(255,100,100) end
end

local function activate()
    if not selectedTarget then
        if statusLabel then statusLabel.Text = "⚠️ SELECT TARGET FIRST!" end
        return
    end
    deactivate()
    task.wait(0.1)
    isActive = true
    orbitAngle = 0
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("Humanoid") then c.Humanoid.WalkSpeed, c.Humanoid.JumpPower = 180, 120 end
    if statusLabel then statusLabel.Text, statusLabel.TextColor3 = "📌 STATUS: ACTIVE - MODE: "..currentMode.." - TARGET: "..selectedTarget.Name, Color3.fromRGB(0,255,100) end
    
    if currentMode == "SOLO" then startSolo()
    elseif currentMode == "ORBIT" then startOrbit()
    elseif currentMode == "FEET" then startFeet() end
    if autoCombo then runAutoCombo() end
    if instantKill then runInstantKill() end
    if autoBlock then runAutoBlock() end
    
    task.spawn(function()
        while isActive and emergency do
            local c, h = LocalPlayer.Character, LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if c and h and (h.Health/h.MaxHealth)*100 < 25 then teleportSafe() end
            task.wait(1)
        end
    end)
end

