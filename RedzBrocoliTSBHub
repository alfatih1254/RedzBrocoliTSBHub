local function destroyAllESP()
    for player, data in pairs(espDataStore) do
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
    end
    espDataStore = {}
end

local function stopESPLoop()
    if espUpdateLoop then
        espUpdateLoop:Disconnect()
        espUpdateLoop = nil
    end
end

local function startESPLoop()
    if espUpdateLoop then return end
    espUpdateLoop = RunService.Heartbeat:Connect(function()
        if not espOn then return end
        for player, _ in pairs(espDataStore) do
            refreshESPForPlayer(player)
        end
    end)
end

local function toggleESP()
    espOn = not espOn
    if espOn then
        destroyAllESP()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then buildESPForPlayer(player) end
        end
        startESPLoop()
        showNotification("ESP ACTIVATED", 2)
    else
        stopESPLoop()
        destroyAllESP()
        showNotification("ESP DEACTIVATED", 2)
    end
end

local function stopAllActions()
    isActive = false
    soloRunning = false
    orbitRunning = false
    feetRunning = false
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = 16
        char.Humanoid.JumpPower = 50
    end
    if statusLabel then
        statusLabel.Text = "● INACTIVE"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
    showNotification("All actions stopped", 1.5)
end

local function activate()
    if not selectedTarget then
        if statusLabel then statusLabel.Text = "⚠️ NO TARGET" end
        showNotification("Select target first!", 2)
        return
    end
    stopAllActions()
    task.wait(0.1)
    isActive = true
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = 180
        char.Humanoid.JumpPower = 120
    end
    
    if statusLabel then
        statusLabel.Text = "● ACTIVE - " .. currentMode .. " → " .. selectedTarget.Name
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    end
    
    if currentMode == "SOLO" then startSoloMode()
    elseif currentMode == "ORBIT" then startOrbitMode()
    elseif currentMode == "FEET" then startFeetMode() end
    
    task.spawn(function()
        while isActive and emergency do
            local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if humanoid and (humanoid.Health / humanoid.MaxHealth) * 100 < 25 then
                emergencyProtocol()
            end
            task.wait(1)
        end
    end)
end

