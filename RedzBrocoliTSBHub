-- Clean up all active connections
local function cleanup()
    for _, connection in pairs(activeConnections) do
        pcall(function() connection:Disconnect() end)
    end
    activeConnections = {}
    isActive = false
    emergencyTeleported = false

    -- Restore character speed
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = originalWalkSpeed
            humanoid.JumpPower = originalJumpPower
            humanoid.BreakJointsOnDeath = originalBreakJoints
        end
    end

    -- Restore target speed if exists
    if selectedTarget and selectedTarget.Character then
        local targetHumanoid = selectedTarget.Character:FindFirstChild("Humanoid")
        if targetHumanoid then
            targetHumanoid.WalkSpeed = originalWalkSpeed
            targetHumanoid.JumpPower = originalJumpPower
        end
    end

    -- Update UI
    if not godModeEnabled and led then
        led.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    end
    if statusText then
        statusText.Text = "MODE: INACTIVE | TARGET: " .. (selectedTarget and selectedTarget.Name or "NONE")
    end
end

-- Activate selected mode
local function activateMode()
    if not selectedTarget then
        if statusText then
            statusText.Text = "⚠️ PLEASE SELECT A TARGET FIRST!"
        end
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "⚠️ NO TARGET",
                Text = "Please click on a player in the list first!",
                Duration = 2
            })
        end)
        return
    end

    -- Clean up previous session
    cleanup()
    task.wait(0.1)

    -- Set active flags
    isActive = true
    orbitAngle = 0
    emergencyTeleported = false

    -- Update UI
    if led then
        led.BackgroundColor3 = Color3.fromRGB(0, 200, 150)
    end
    if statusText then
        statusText.Text = "⚡ " .. currentMode .. " | TARGET: " .. selectedTarget.Name
    end

    -- Get character and ensure it exists
    local character = LocalPlayer.Character
    if not character then
        LocalPlayer.CharacterAdded:Wait()
        character = LocalPlayer.Character
    end

    -- Apply speed boost
    if character and character:FindFirstChild("Humanoid") then
        local humanoid = character.Humanoid
        originalWalkSpeed = humanoid.WalkSpeed
        originalJumpPower = humanoid.JumpPower
        originalBreakJoints = humanoid.BreakJointsOnDeath

        humanoid.WalkSpeed = 180
        humanoid.JumpPower = 120
    end

    -- Freeze target
    if selectedTarget and selectedTarget.Character then
        local targetHumanoid = selectedTarget.Character:FindFirstChild("Humanoid")
        if targetHumanoid then
            targetHumanoid.WalkSpeed = 0
            targetHumanoid.JumpPower = 0
        end

        -- Watch for target respawn to re-freeze
        local targetRespawnConnection = selectedTarget.CharacterAdded:Connect(function(newCharacter)
            task.wait(0.3)
            if isActive and selectedTarget and newCharacter then
                local newHumanoid = newCharacter:FindFirstChild("Humanoid")
                if newHumanoid then
                    newHumanoid.WalkSpeed = 0
                    newHumanoid.JumpPower = 0
                end
            end
        end)
        table.insert(activeConnections, targetRespawnConnection)
    end

    -- Emergency monitor
    local emergencyConnection = RunService.Stepped:Connect(emergencyTeleportCheck)
    table.insert(activeConnections, emergencyConnection)

    -- ============================================
    -- MODE: SOLO HACK (Random teleport around target)
    -- ============================================
    if currentMode == "SOLO" then
        local soloConnection = RunService.RenderStepped:Connect(function()
            if not isActive or emergencyTeleported then return end

            local myCharacter = LocalPlayer.Character
            if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return end

            if not selectedTarget or not selectedTarget.Character then return end
            local targetRoot = selectedTarget.Character:FindFirstChild("HumanoidRootPart")
            if not targetRoot then return end

            local targetPosition = targetRoot.Position
            local randomAngle = math.random() * 2 * math.pi
            local radius = soloRadius
            local x = targetPosition.X + math.cos(randomAngle) * radius
            local z = targetPosition.Z + math.sin(randomAngle) * radius
            local yOffset = math.random(1, 4)
            local newPosition = Vector3.new(x, targetPosition.Y + yOffset, z)

            -- Teleport and face target
            myCharacter.HumanoidRootPart.CFrame = CFrame.new(newPosition, targetPosition)

            -- Auto attack
            pcall(function()
                VirtualUser:ClickButton1(Vector2.new(500, 500), 1)
            end)
        end)
        table.insert(activeConnections, soloConnection)

    -- ============================================
    -- MODE: ORBIT (Circle around target)
    -- ============================================
    elseif currentMode == "ORBIT" then
        local orbitConnection = RunService.RenderStepped:Connect(function()
            if not isActive or emergencyTeleported then return end

            local myCharacter = LocalPlayer.Character
            if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return end

            if not selectedTarget or not selectedTarget.Character then return end
            local targetRoot = selectedTarget.Character:FindFirstChild("HumanoidRootPart")
            if not targetRoot then return end

            orbitAngle = orbitAngle + orbitSpeed * 0.05
            local targetPosition = targetRoot.Position
            local x = targetPosition.X + math.cos(orbitAngle) * orbitRadius
            local z = targetPosition.Z + math.sin(orbitAngle) * orbitRadius
            local newPosition = Vector3.new(x, targetPosition.Y + 2, z)

            -- Teleport and face target
            myCharacter.HumanoidRootPart.CFrame = CFrame.new(newPosition, targetPosition)

            -- Auto attack
            pcall(function()
                VirtualUser:ClickButton1(Vector2.new(500, 500), 1)
            end)
        end)
        table.insert(activeConnections, orbitConnection)

    -- ============================================
    -- MODE: FEET (Stay below target)
    -- ============================================
    elseif currentMode == "FEET" then
        local feetConnection = RunService.RenderStepped:Connect(function()
            if not isActive or emergencyTeleported then return end

            local myCharacter = LocalPlayer.Character
            if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return end

            if not selectedTarget or not selectedTarget.Character then return end
            local targetRoot = selectedTarget.Character:FindFirstChild("HumanoidRootPart")
            if not targetRoot then return end

            local targetPosition = targetRoot.Position
            local newPosition = Vector3.new(targetPosition.X, targetPosition.Y - feetDistance, targetPosition.Z)

            -- Teleport and face target
            myCharacter.HumanoidRootPart.CFrame = CFrame.new(newPosition, targetPosition)

            -- Auto attack
            pcall(function()
                VirtualUser:ClickButton1(Vector2.new(500, 500), 1)
            end)
        end)
        table.insert(activeConnections, feetConnection)
    end

    -- ============================================
    -- COMMON CONNECTIONS FOR ALL MODES
    -- ============================================

    -- Keep target frozen
    local freezeConnection = RunService.Stepped:Connect(function()
        if isActive and not emergencyTeleported and selectedTarget and selectedTarget.Character then
            local targetHumanoid = selectedTarget.Character:FindFirstChild("Humanoid")
            if targetHumanoid then
                if targetHumanoid.WalkSpeed ~= 0 then
                    targetHumanoid.WalkSpeed = 0
                end
                if targetHumanoid.JumpPower ~= 0 then
                    targetHumanoid.JumpPower = 0
                end
            end
        end
    end)
    table.insert(activeConnections, freezeConnection)

    -- Keep player speed boosted
    local speedConnection = RunService.Heartbeat:Connect(function()
        if isActive and not emergencyTeleported then
            local myCharacter = LocalPlayer.Character
            if myCharacter then
                local myHumanoid = myCharacter:FindFirstChild("Humanoid")
                if myHumanoid then
                    if myHumanoid.WalkSpeed ~= 180 then
                        myHumanoid.WalkSpeed = 180
                    end
                    if myHumanoid.JumpPower ~= 120 then
                        myHumanoid.JumpPower = 120
                    end
                end
            end
        end
    end)
    table.insert(activeConnections, speedConnection)

    -- LED blinking animation
    local blinkConnection = RunService.Heartbeat:Connect(function()
        if isActive and not emergencyTeleported and led then
            local brightness = (math.sin(tick() * 15) + 1) / 2
            led.BackgroundColor3 = Color3.fromRGB(
                80 + brightness * 100,
                40 + brightness * 60,
                180 + brightness * 75
            )
        end
    end)
    table.insert(activeConnections, blinkConnection)
end

