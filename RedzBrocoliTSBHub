-- Sliders
local sliders = {
    {label="📍 TELEPORT RADIUS", var="soloRadius", min=2, max=12, default=5, y=45, labelY=65, color=Color3.fromRGB(255,100,200)},
    {label="🔄 ORBIT RADIUS", var="orbitRadius", min=3, max=12, default=5, y=95, labelY=115, color=Color3.fromRGB(150,100,255)},
    {label="⚡ ORBIT SPEED", var="orbitSpeed", min=0.3, max=3, default=1, y=145, labelY=165, color=Color3.fromRGB(100,255,100)},
    {label="🦶 FEET DISTANCE", var="feetDist", min=1, max=10, default=3, y=195, labelY=215, color=Color3.fromRGB(100,200,150)},
}

for _, s in ipairs(sliders) do
    local label = Instance.new("TextLabel", settingsContent)
    label.Size, label.Position = UDim2.new(0, 200, 0, 25), UDim2.new(0, 0, 0, s.labelY)
    label.Text = s.label..": "..s.default
    label.TextColor3, label.BackgroundTransparency = s.color, 1
    
    local bg = Instance.new("Frame", settingsContent)
    bg.Size, bg.Position = UDim2.new(0, 250, 0, 6), UDim2.new(0, 0, 0, s.y)
    bg.BackgroundColor3 = Color3.fromRGB(60,40,100)
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame", bg)
    fill.Size, fill.BackgroundColor3 = UDim2.new(0.3, 0, 1, 0), s.color
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local function setupSlider()
        local dragging = false
        bg.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                local pos = math.clamp((i.Position.X - bg.AbsolutePosition.X)/bg.AbsoluteSize.X, 0, 1)
                local val = s.min + pos * (s.max - s.min)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                label.Text = s.label..": "..string.format("%.1f", val)
                if s.var == "soloRadius" then soloRadius = val
                elseif s.var == "orbitRadius" then orbitRadius = val
                elseif s.var == "orbitSpeed" then orbitSpeed = val
                elseif s.var == "feetDist" then feetDist = val end
                saveConfig()
            end
        end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local pos = math.clamp((i.Position.X - bg.AbsolutePosition.X)/bg.AbsoluteSize.X, 0, 1)
                local val = s.min + pos * (s.max - s.min)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                label.Text = s.label..": "..string.format("%.1f", val)
                if s.var == "soloRadius" then soloRadius = val
                elseif s.var == "orbitRadius" then orbitRadius = val
                elseif s.var == "orbitSpeed" then orbitSpeed = val
                elseif s.var == "feetDist" then feetDist = val end
                saveConfig()
            end
        end)
        local initPos = (s.default - s.min) / (s.max - s.min)
        fill.Size = UDim2.new(initPos, 0, 1, 0)
        label.Text = s.label..": "..string.format("%.1f", s.default)
        if s.var == "soloRadius" then soloRadius = s.default
        elseif s.var == "orbitRadius" then orbitRadius = s.default
        elseif s.var == "orbitSpeed" then orbitSpeed = s.default
        elseif s.var == "feetDist" then feetDist = s.default end
    end
    setupSlider()
end

