-- ============================================
-- NO CLIP (FIX: SAVE & RESTORE COLLISION)
-- ============================================
local function saveOriginalCollision()
    local c = LocalPlayer.Character
    if not c then return end
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") and not originalCollision[part] then
            originalCollision[part] = part.CanCollide
        end
    end
end

local function applyNoClip()
    local c = LocalPlayer.Character
    if not c then return end
    saveOriginalCollision()
    for _, part in ipairs(c:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function removeNoClip()
    local c = LocalPlayer.Character
    if not c then return
    end
    for part, original in pairs(originalCollision) do
        if part and part.Parent then
            part.CanCollide = original
        end
    end
    originalCollision = {}
end

local function runNoClip()
    if noclipLoopRunning then return end
    noclipLoopRunning = true
    task.spawn(function()
        while noClip do
            applyNoClip()
            task.wait(0.1)
        end
        removeNoClip()
        noclipLoopRunning = false
    end)
end

