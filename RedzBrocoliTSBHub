local function createCircularSlider(parent, xPos, yPos, sliderWidth, minVal, maxVal, defaultVal, callback, labelText, sliderColor)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(0, 200, 0, 22)
    label.Position = UDim2.new(0, xPos, 0, yPos)
    label.Text = labelText .. ": " .. string.format("%.1f", defaultVal)
    label.TextColor3 = sliderColor or Color3.fromRGB(200, 200, 255)
    label.TextSize = 12
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    
    local background = Instance.new("Frame", parent)
    background.Size = UDim2.new(0, sliderWidth, 0, 6)
    background.Position = UDim2.new(0, xPos, 0, yPos + 25)
    background.BackgroundColor3 = Color3.fromRGB(60, 40, 100)
    Instance.new("UICorner", background).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame", background)
    fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = sliderColor or Color3.fromRGB(150, 100, 255)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local knob = Instance.new("Frame", background)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), -8, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    knob.BorderSizePixel = 2
    knob.BorderColor3 = sliderColor or Color3.fromRGB(150, 100, 255)
    
    local isDragging = false
    
    local function updateFromPosition(inputPosition)
        local normalizedPos = math.clamp((inputPosition - background.AbsolutePosition.X) / background.AbsoluteSize.X, 0, 1)
        local newValue = minVal + normalizedPos * (maxVal - minVal)
        fill.Size = UDim2.new(normalizedPos, 0, 1, 0)
        knob.Position = UDim2.new(normalizedPos, -8, 0.5, -8)
        label.Text = labelText .. ": " .. string.format("%.1f", newValue)
        callback(newValue)
    end
    
    background.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            updateFromPosition(input.Position.X)
        end
    end)
    
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            updateFromPosition(input.Position.X)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromPosition(input.Position.X)
        end
    end)
end

