local function applyGodMode()
    local c = LocalPlayer.Character
    if not c then return end
    if currentFF then currentFF:Destroy() end
    currentFF = Instance.new("ForceField", c)
    currentFF.Name = "RedzGodMode"
    local p = Instance.new("ParticleEmitter", c:FindFirstChild("HumanoidRootPart") or c)
    p.Texture, p.Color, p.Size, p.Rate, p.Lifetime, p.SpreadAngle, p.Speed = "rbxasset://textures/particles/sparkles_main.dds", ColorSequence.new(Color3.fromRGB(0,150,255), Color3.fromRGB(255,50,150)), NumberSequence.new(0.5), 40, NumberRange.new(0.6), Vector2.new(360,360), NumberRange.new(4)
    local h = c:FindFirstChild("Humanoid")
    if h then h.BreakJointsOnDeath = false end
end

local function removeGodMode()
    if currentFF then currentFF:Destroy() end
    local c = LocalPlayer.Character
    if c then
        for _, v in ipairs(c:GetDescendants()) do if v.Name == "RedzGodMode_Particles" then v:Destroy() end end
        for _, v in ipairs(c:GetChildren()) do if v:IsA("ForceField") then v:Destroy() end end
        local h = c:FindFirstChild("Humanoid")
        if h then h.BreakJointsOnDeath = true end
    end
end

